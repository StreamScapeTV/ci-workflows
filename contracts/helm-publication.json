{
  "chart_digest": "remote-oci-manifest-sha256",
  "forbidden_capabilities": [
    "kubernetes",
    "sops-decryption",
    "latest"
  ],
  "idempotency": "pull-compare-before-push",
  "kubernetes_authority": "forbidden",
  "named_secrets": [
    "registry_username",
    "registry_token"
  ],
  "oci_publication_evidence": {
    "api": "oci.publish",
    "binding": "exact-source-version-target-repository-digest-parity",
    "inputs": [
      "image_digest",
      "immutable_references_json"
    ],
    "no_image_binding": "both-inputs-omitted"
  },
  "read_back": "required-oci-pull-and-normalized-sha256",
  "registry_host": "git.faruqi.dev",
  "registry_namespace": "mimranfaruqi/helm-charts",
  "release_binding_contract": "contracts/helm-release-bindings.json",
  "schema_version": 1,
  "source_trust": "trusted-exact",
  "tag_authority": "resolve-and-revalidate-before-write",
  "version_policy": "immutable-semver-no-latest"
}
