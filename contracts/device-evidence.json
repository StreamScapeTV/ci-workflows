{
  "allowed_fields": [
    "packet_version",
    "request_id",
    "issue_number",
    "repository",
    "source_sha",
    "device_family",
    "device_profile",
    "device_identity_hash",
    "classification",
    "lock",
    "command_profiles",
    "started_at",
    "ended_at",
    "duration_seconds",
    "result",
    "failure_code",
    "assertions",
    "restoration",
    "cleanup",
    "artifact_exception_id",
    "retained_evidence",
    "certification_scope",
    "limitations"
  ],
  "artifact_inventory_fields": [
    "name",
    "media_type",
    "bytes",
    "sha256"
  ],
  "certification_scope_by_family": {
    "android": "physical-device/android",
    "ios": "physical-device/ios",
    "tvos": "physical-device/tvos"
  },
  "classification_fields": [
    "family",
    "os_or_api",
    "model_class",
    "capabilities",
    "connection_class"
  ],
  "contract_version": "1.0.0",
  "forbidden_fields": [
    "serial",
    "udid",
    "raw_identifier",
    "hostname",
    "ip_address",
    "endpoint",
    "token",
    "password",
    "authorization",
    "credential",
    "environment",
    "screenshot",
    "trace",
    "private_media",
    "personal_data"
  ],
  "forbidden_value_patterns": [
    "(?i)bearer\\s+[a-z0-9._-]+",
    "(?i)(token|password|secret|authorization)\\s*[:=]",
    "(?i)https?://[^\\s]+",
    "(?:[0-9]{1,3}\\.){3}[0-9]{1,3}"
  ],
  "identity_hash_regex": "^[0-9a-f]{64}$",
  "lock_redaction_fields": [
    "accepted",
    "epoch",
    "owner_hash",
    "resource_key_hash",
    "release_receipt"
  ],
  "maximum_assertions": 32,
  "maximum_packet_bytes": 32768,
  "maximum_retained_files": 12,
  "packet_version": "device-evidence/1",
  "required_fields": [
    "packet_version",
    "request_id",
    "issue_number",
    "repository",
    "source_sha",
    "device_family",
    "device_profile",
    "device_identity_hash",
    "classification",
    "lock",
    "command_profiles",
    "started_at",
    "ended_at",
    "duration_seconds",
    "result",
    "failure_code",
    "assertions",
    "restoration",
    "cleanup",
    "artifact_exception_id",
    "retained_evidence",
    "certification_scope",
    "limitations"
  ],
  "required_limitations": [
    "does-not-certify-simulator-or-emulator",
    "does-not-authorize-release-signing-store-or-deployment",
    "certifies-only-the-reviewed-profile-and-exact-source"
  ],
  "schema_version": 1
}
