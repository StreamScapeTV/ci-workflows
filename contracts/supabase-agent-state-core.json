{
  "schema_version": 1,
  "contract_version": 1,
  "authority": "Supabase PostgreSQL",
  "source_status": "pre-deployment-review-package",
  "private_schema": "agent_private",
  "api_schema": "agent_api",
  "project_locking": "request advisory lock, project advisory lock, project/slot/session row locks",
  "request_hash": "sha256 of canonical jsonb text",
  "migration_order": [
    "supabase/migrations/20260806172100_agent_state_core_schema.sql",
    "supabase/migrations/20260806172200_agent_state_core_rpc.sql",
    "supabase/migrations/20260806172300_agent_state_core_indexes.sql"
  ],
  "roles": {
    "ordinary_rpc_role": "service_role",
    "direct_table_roles_revoked": [
      "PUBLIC",
      "anon",
      "authenticated",
      "service_role"
    ],
    "api_execute_roles": [
      "service_role"
    ]
  },
  "rpc": {
    "command": "agent_api.command(jsonb)",
    "resume": "agent_api.resume(text,text,text)",
    "context": "agent_api.context(text,text,text)",
    "ownership_check": "agent_api.ownership_check(text,text,bigint,text,bigint,text)"
  },
  "actions": {
    "resume": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name"
      ],
      "optional": []
    },
    "start": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name",
        "task",
        "issue_number",
        "branch",
        "base_sha"
      ],
      "optional": [
        "agent_id",
        "branch_nonce",
        "pr_number",
        "head_sha",
        "claims"
      ]
    },
    "claim": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name",
        "agent_id",
        "issue_number",
        "branch",
        "claims"
      ],
      "optional": [
        "pr_number",
        "head_sha"
      ]
    },
    "release": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name",
        "agent_id",
        "issue_number",
        "branch"
      ],
      "optional": [
        "claims",
        "all"
      ]
    },
    "reconcile_base": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name",
        "agent_id",
        "issue_number",
        "branch",
        "expected_base_sha",
        "base_sha"
      ],
      "optional": []
    },
    "block": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name",
        "agent_id",
        "issue_number",
        "branch",
        "reason"
      ],
      "optional": []
    },
    "review": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name",
        "agent_id",
        "issue_number",
        "branch",
        "pr_number",
        "head_sha"
      ],
      "optional": [
        "summary"
      ]
    },
    "done": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name",
        "agent_id",
        "issue_number",
        "branch",
        "merge_sha",
        "summary"
      ],
      "optional": [
        "pr_number",
        "head_sha"
      ]
    },
    "cancel": {
      "required": [
        "contract_version",
        "request_id",
        "action",
        "project",
        "repository",
        "session_name",
        "agent_id",
        "issue_number",
        "branch",
        "summary"
      ],
      "optional": []
    }
  },
  "reads": [
    "agent_api.resume",
    "agent_api.context",
    "agent_api.ownership_check"
  ],
  "claim_kinds": {
    "file": [
      "exact",
      "prefix"
    ],
    "package": [
      "exact"
    ],
    "resource": [
      "exact"
    ],
    "manifest": [
      "exact"
    ],
    "device": [
      "exact"
    ]
  },
  "nonterminal_statuses": [
    "active",
    "blocked",
    "review"
  ],
  "terminal_statuses": [
    "done",
    "cancelled"
  ],
  "identity": {
    "session_name_pattern": "^(Agent|Codex) ([1-9][0-9]?)$",
    "agent_id_patterns": {
      "Agent": "^gpt-agent-<slot>-YYYYMMDD-HHMM-[a-z0-9]{4}$",
      "Codex": "^cod-agent-<slot>-YYYYMMDD-HHMM-[a-z0-9]{4}$"
    },
    "enabled_slots": [
      1,
      2,
      3,
      4,
      5,
      6,
      7,
      8,
      9
    ],
    "branch_pattern": "^issue/<issue>-<lowercase-slug>-<four-character-nonce>$"
  },
  "projects": [
    {
      "project": "ci-workflows",
      "repository": "StreamScapeTV/ci-workflows",
      "integration_branch": "main"
    },
    {
      "project": "iptv-backend",
      "repository": "StreamScapeTV/iptv-backend",
      "integration_branch": "main"
    },
    {
      "project": "StreamScapeWeb",
      "repository": "StreamScapeTV/StreamScapeWeb",
      "integration_branch": "main"
    },
    {
      "project": "iptv-android",
      "repository": "StreamScapeTV/iptv-android",
      "integration_branch": "develop"
    },
    {
      "project": "iptv-apple",
      "repository": "StreamScapeTV/iptv-apple",
      "integration_branch": "develop"
    },
    {
      "project": "streamscape-media",
      "repository": "StreamScapeTV/streamscape-media",
      "integration_branch": "develop"
    },
    {
      "project": "directus-front",
      "repository": "StreamScapeTV/directus-front",
      "integration_branch": "main"
    },
    {
      "project": "finance-hub",
      "repository": "StreamScapeTV/finance-hub",
      "integration_branch": "main"
    },
    {
      "project": "agent-state",
      "repository": "StreamScapeTV/agent-state",
      "integration_branch": "main"
    },
    {
      "project": "flux",
      "repository": "StreamScapeTV/flux",
      "integration_branch": "main"
    },
    {
      "project": "organization-rules",
      "repository": "StreamScapeTV/organization-rules",
      "integration_branch": "main"
    },
    {
      "project": "agent-state-supabase",
      "repository": "StreamScapeTV/agent-state-supabase",
      "integration_branch": "main"
    }
  ],
  "atomicity": {
    "start_plus_initial_claims": true,
    "done_plus_release": true,
    "cancel_plus_release": true,
    "conflicting_request_reuse_mutates": false
  },
  "redaction": {
    "receipt_forbidden_fields": [
      "project_id",
      "session_id",
      "request_hash",
      "database_url",
      "authorization",
      "sql"
    ],
    "bounded_text_rejects_credential_patterns": true,
    "context_event_payload_exposed": false,
    "context_event_limit": 50
  },
  "future_extensions": [
    "#53",
    "#54",
    "#55"
  ],
  "out_of_scope_actions": [
    "park",
    "activate",
    "transfer",
    "takeover",
    "review_request",
    "review_approve",
    "bot_start",
    "cutover",
    "retire"
  ]
}
