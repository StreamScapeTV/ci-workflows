{
  "schema_version": 2,
  "store": "cloudflare-r2",
  "object_prefix": "ci-diagnostics",
  "content_type": "application/gzip",
  "format": "gzip-private-runner-log",
  "limits": {
    "max_raw_bytes": 52428800,
    "max_compressed_bytes": 20971520
  },
  "identity": [
    "ci_run_id",
    "github_run_id",
    "run_attempt"
  ],
  "credentials": {
    "transport": "fixed-environment-only",
    "environment": [
      "R2_ACCOUNT_ID",
      "R2_BUCKET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY"
    ],
    "caller_selectable": false
  },
  "write_policy": {
    "gzip_before_upload": true,
    "read_back_after_upload": true,
    "sha256_verify_read_back": true,
    "github_actions_artifact": false
  },
  "github_public_log": {
    "private_repository_identity_in_dispatch_inputs": false,
    "private_ref_in_dispatch_inputs": false,
    "private_command_stdout_stderr": false,
    "allowed_content": "generic-orchestration-and-pass-fail-only"
  },
  "agent_state": {
    "raw_logs_forbidden": true,
    "receipt_field": "diagnostic_key",
    "status_field": "diagnostic_status",
    "uploaded_status": "uploaded",
    "receipt_format": "r2:<object_key>#sha256=<compressed_sha256>",
    "terminal_order": "upload-readback-verify-r2-before-terminal-transition"
  },
  "retention": {
    "agent_state_hours": 24,
    "r2_object_lifecycle": "bucket-policy-owned"
  }
}
