{
  "schema_version": 1,
  "organization": "StreamScapeTV",
  "token_model": {
    "called_workflow_cannot_elevate": true,
    "caller_declares_minimum": true,
    "secrets_inherit_forbidden": true,
    "default_unspecified_permission": "none"
  },
  "profiles": [
    {
      "id": "source-read",
      "trust_class": "source-admission",
      "caller_permissions": {"contents": "read", "pull-requests": "read"},
      "workflow_permissions": {"contents": "read", "pull-requests": "read"},
      "forbidden_permissions": ["actions:write", "checks:write", "contents:write", "deployments:write", "id-token:write", "issues:write", "packages:write", "pull-requests:write", "statuses:write"],
      "named_secrets_allowed": [],
      "notes": "Exact source and tag admission; no product or infrastructure credential."
    },
    {
      "id": "validation-read",
      "trust_class": "read-only-validation",
      "caller_permissions": {"contents": "read"},
      "workflow_permissions": {"contents": "read"},
      "forbidden_permissions": ["actions:write", "checks:write", "contents:write", "deployments:write", "id-token:write", "issues:write", "packages:write", "pull-requests:write", "statuses:write"],
      "named_secrets_allowed": ["maven_package_read_token", "private_dependency_token", "repository_app_id", "repository_app_private_key", "service_username", "service_password"],
      "notes": "Exact-source validation permits fixed package/read and repository App credentials only when an API explicitly projects them into bounded source or dependency access; routine planning and evidence remain credential-free."
    },
    {
      "id": "device-validation",
      "trust_class": "physical-device-validation",
      "caller_permissions": {"contents": "read"},
      "workflow_permissions": {"contents": "read"},
      "forbidden_permissions": ["actions:write", "checks:write", "contents:write", "deployments:write", "id-token:write", "issues:write", "packages:write", "pull-requests:write", "statuses:write"],
      "named_secrets_allowed": ["device_authorization_receipt"],
      "notes": "Physical-device execution is admitted only by the exact device_authorization_receipt; caller command environment is bounded and non-secret, and no product live-backend credential or signing/store credential is accepted by Central."
    },
    {
      "id": "oci-publication",
      "trust_class": "trusted-publication",
      "caller_permissions": {"contents": "read"},
      "workflow_permissions": {"contents": "read"},
      "forbidden_permissions": ["actions:write", "checks:write", "contents:write", "deployments:write", "id-token:write", "issues:write", "pull-requests:write", "statuses:write"],
      "named_secrets_allowed": ["registry_username", "registry_token"],
      "notes": "Demonstrated private-registry Gradle and native image/chart publication uses named workflow-scoped credentials; no cluster credential."
    },
    {
      "id": "public-oci-publication",
      "trust_class": "trusted-publication",
      "caller_permissions": {"contents": "read", "packages": "write"},
      "workflow_permissions": {"contents": "read", "packages": "write"},
      "forbidden_permissions": ["actions:write", "checks:write", "contents:write", "deployments:write", "id-token:write", "issues:write", "pull-requests:write", "statuses:write"],
      "named_secrets_allowed": [],
      "notes": "Public GHCR image and Helm OCI publication uses only the caller repository GITHUB_TOKEN with packages write; no named registry or cluster secret."
    },
    {
      "id": "bootstrap-tag-publication",
      "trust_class": "trusted-publication",
      "caller_permissions": {"contents": "read"},
      "workflow_permissions": {"contents": "read"},
      "forbidden_permissions": ["actions:write", "checks:write", "contents:write", "deployments:write", "id-token:write", "issues:write", "pull-requests:write", "statuses:write"],
      "named_secrets_allowed": ["registry_username", "registry_token"],
      "notes": "Compatibility profile for the deprecated exact-tag image/chart publisher; exact source, registry credentials, remote publication read-back, and cleanup are functional release boundaries."
    }
  ]
}
