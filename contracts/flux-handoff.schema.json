{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscapetv.invalid/schemas/flux-release-handoff-v1.json",
  "title": "StreamScapeTV reviewed Flux release selection handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "producer_repository",
    "target_repository",
    "release_id",
    "release_version",
    "source_sha",
    "release_manifest_sha256",
    "github_release_url",
    "products",
    "requested_action",
    "mutation_authorized",
    "secrets_included"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "flux-selection-request"},
    "producer_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 128},
    "target_repository": {"const": "StreamScapeTV/flux"},
    "release_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "release_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$", "maxLength": 128},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "github_release_url": {"type": "string", "pattern": "^https://github\\.com/StreamScapeTV/[A-Za-z0-9_.-]+/releases/tag/[0-9A-Za-z.-]+$", "maxLength": 512},
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/productIdentity"}
    },
    "requested_action": {"const": "review-selection"},
    "mutation_authorized": {"const": false},
    "secrets_included": {"const": false}
  },
  "$defs": {
    "productIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "kind", "digest", "immutable_references"],
      "properties": {
        "product_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "kind": {"enum": ["oci-image", "helm-chart"]},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "immutable_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^[:space:]]+$"
          }
        }
      }
    }
  }
}
