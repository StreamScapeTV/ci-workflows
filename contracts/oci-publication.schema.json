{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscape.tv/contracts/oci-publication.schema.json",
  "title": "StreamScapeTV trusted OCI publication public request and result",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stableSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "productId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "containerPath": {
      "type": "string",
      "pattern": "^/(?!/)(?!.*\\s$)(?!\\.{1,2}(?:/|$))[^/\\u0000\\r\\n]+(?:/(?!\\.{1,2}(?:/|$))[^/\\u0000\\r\\n]+)*$",
      "maxLength": 4096
    },
    "assertionVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "digest"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "assertionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "verified_platforms", "contract_digest", "runtime", "filesystem", "healthcheck"],
      "properties": {
        "result": {"const": "passed"},
        "verified_platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^linux/(?:amd64|arm64/v8)$"}
        },
        "contract_digest": {"$ref": "#/$defs/digest"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user", "entrypoint", "command", "ports"],
          "properties": {
            "user": {
              "oneOf": [
                {"type": "string", "maxLength": 256},
                {"type": "null"}
              ]
            },
            "entrypoint": {"$ref": "#/$defs/assertionVector"},
            "command": {"$ref": "#/$defs/assertionVector"},
            "ports": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[0-9]{1,5}/(?:tcp|udp)$"}
            }
          }
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_files", "required_tools", "required_executables", "forbidden_tools", "forbidden_paths"],
          "properties": {
            "required_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/containerPath"}},
            "required_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"}},
            "required_executables": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/containerPath"}},
            "forbidden_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"}},
            "forbidden_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/containerPath"}}
          }
        },
        "healthcheck": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {"mode": {"const": "absent"}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "test_mode", "test", "interval_nanoseconds", "timeout_nanoseconds", "start_period_nanoseconds", "start_interval_nanoseconds", "retries"],
              "properties": {
                "mode": {"const": "exact"},
                "test_mode": {"enum": ["CMD", "CMD-SHELL", "NONE"]},
                "test": {"$ref": "#/$defs/assertionVector"},
                "interval_nanoseconds": {"type": "integer", "minimum": 0},
                "timeout_nanoseconds": {"type": "integer", "minimum": 0},
                "start_period_nanoseconds": {"type": "integer", "minimum": 0},
                "start_interval_nanoseconds": {"type": "integer", "minimum": 0},
                "retries": {"type": "integer", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "baseReference": {
      "oneOf": [
        {"const": "scratch"},
        {
          "type": "string",
          "minLength": 73,
          "maxLength": 327,
          "pattern": "^(?![a-z0-9._:/-]*//)(?![a-z0-9._:/-]*/\\.{1,2}/)[a-z0-9](?:[a-z0-9._:/-]*[a-z0-9])?@sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^ghcr\\.io/streamscapetv/(?!\\.{1,2}$)[a-z0-9._-]+$"
    },
    "immutableTagReference": {
      "type": "string",
      "pattern": "^ghcr\\.io/streamscapetv/(?!\\.{1,2}:)[a-z0-9._-]+:(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|sha-[0-9a-f]{40})$"
    },
    "platformEvidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^linux/(?:amd64|arm64/v8)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_digest", "config_digest", "layer_digests", "labels"],
          "properties": {
            "manifest_digest": {"$ref": "#/$defs/digest"},
            "config_digest": {"$ref": "#/$defs/digest"},
            "layer_digests": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/digest"}
            },
            "labels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string"}
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted_sha", "product_id", "release_version"],
      "properties": {
        "admitted_sha": {"$ref": "#/$defs/sha"},
        "product_id": {"$ref": "#/$defs/productId"},
        "release_version": {"$ref": "#/$defs/stableSemver"},
        "platform_set": {"$ref": "#/$defs/productId"}
      }
    },
    "targetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "version", "source_reference", "manifest_digest", "base_references", "assertions"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "version": {"$ref": "#/$defs/immutableTagReference"},
        "source_reference": {"$ref": "#/$defs/immutableTagReference"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "base_references": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/baseReference"}
        },
        "assertions": {"$ref": "#/$defs/assertionEvidence"}
      }
    },
    "fluxSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canary_id", "previous_known_good", "rollback_id"],
      "properties": {
        "canary_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "previous_known_good": {"type": "string", "minLength": 1, "maxLength": 256},
        "rollback_id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "manifest_digests", "platform_digests", "immutable_references"],
      "properties": {
        "result": {"const": "success"},
        "manifest_digests": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/productId"},
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9]+(?:[._-][a-z0-9]+)*$": {"$ref": "#/$defs/digest"}
          }
        },
        "platform_digests": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/productId"},
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z0-9]+(?:[._-][a-z0-9]+)*$": {"$ref": "#/$defs/platformEvidence"}
          }
        },
        "immutable_references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "release"],
          "properties": {
            "targets": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"$ref": "#/$defs/productId"},
              "additionalProperties": false,
              "patternProperties": {
                "^[a-z0-9]+(?:[._-][a-z0-9]+)*$": {"$ref": "#/$defs/targetReference"}
              }
            },
            "release": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_sha", "version"],
              "properties": {
                "source_sha": {"$ref": "#/$defs/sha"},
                "version": {"$ref": "#/$defs/stableSemver"}
              }
            },
            "flux": {"$ref": "#/$defs/fluxSelection"}
          }
        }
      }
    }
  }
}
