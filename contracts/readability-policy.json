{
  "exception_required_fields": [
    "id",
    "issue",
    "path",
    "rules",
    "reason",
    "removal_condition",
    "tests"
  ],
  "exceptions": [
    {
      "id": "issue-34-bootstrap-publisher",
      "issue": 34,
      "path": ".github/workflows/reusable-tag-image-chart.yml",
      "reason": "The bounded bootstrap publisher predates the named-function architecture and retains only its existing reviewed exceptions.",
      "removal_condition": "Remove with the contracted replacement for the deprecated bootstrap publication workflow.",
      "rules": [
        "oversized-inline-run",
        "complex-yaml-logic",
        "caller-cancelling-concurrency",
        "public-api-doc-drift"
      ],
      "tests": [
        "tests/test_reusable_tag_image_chart.py",
        "tests/test_validation_harness.py"
      ]
    },
    {
      "id": "issue-37-legacy-agent-state-run",
      "issue": 37,
      "path": "src/ci_workflows/agent_state_command.py",
      "reason": "The protected temporary Agent State compatibility transport predates the named-function convergence and exposes its tested legacy run entry point. Issue #31 does not rename or absorb Agent State transport semantics.",
      "removal_condition": "Remove when the temporary #37 compatibility transport is retired after canonical Agent State cutover and legacy-consumer retirement.",
      "rules": [
        "opaque-function-name"
      ],
      "tests": [
        "tests/test_agent_state_command.py",
        "tests/test_readability_contract.py"
      ]
    }
  ],
  "forbidden_generic_inputs": [
    "arbitrary_command",
    "shell",
    "callback",
    "callback_url",
    "handler",
    "function_name",
    "module_name",
    "runner",
    "runs_on",
    "runner_labels",
    "container_engine",
    "secret_name",
    "deletion_path",
    "workspace_root"
  ],
  "limits": {
    "complex_loop_min_lines": 12,
    "composite_action_depth": 1,
    "duplicate_block_min_lines": 8,
    "inline_run_lines": 40,
    "internal_leaf_reusable_children": 0,
    "matrix_jobs": 16,
    "public_reusable_workflow_depth": 1,
    "public_workflow_jobs": 7
  },
  "opaque_identifiers": [
    "job",
    "task",
    "step",
    "run",
    "work",
    "misc"
  ],
  "policy_version": "1.0.0",
  "schema_version": 1,
  "shell_functions_forbidden": true
}
