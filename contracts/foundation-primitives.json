{
  "schema_version": 1,
  "architecture": "consumer workflow -> public action -> named tested function",
  "modules": [
    {
      "module": "ci_workflows.workspace",
      "trust_class": "shared-foundation",
      "functions": [
        {
          "name": "prepare_workspace",
          "inputs": [
            "WorkspaceContext",
            "profile",
            "cache_mode",
            "source_sha",
            "lock_digest",
            "trust_mode",
            "contract_root"
          ],
          "outputs": [
            "WorkspaceState"
          ],
          "side_effects": [
            "creates one marker-bound workflow state root",
            "creates only contract-selected isolated directories"
          ],
          "cleanup": "cleanup_workspace"
        },
        {
          "name": "resolve_state_root",
          "inputs": [
            "runner_temp",
            "state_id",
            "declared_root",
            "contract_root"
          ],
          "outputs": [
            "Path"
          ],
          "side_effects": [
            "derives the only permitted state root beneath protected RUNNER_TEMP",
            "rejects substituted CI_WORKFLOW_ROOT values"
          ],
          "cleanup": "none"
        },
        {
          "name": "register_state_path",
          "inputs": [
            "state_root",
            "name",
            "relative",
            "kind",
            "contract_root",
            "create"
          ],
          "outputs": [
            "Path"
          ],
          "side_effects": [
            "appends one bounded dynamic path to the state registry"
          ],
          "cleanup": "remove_registered_path or cleanup_workspace"
        },
        {
          "name": "remove_registered_path",
          "inputs": [
            "state_root",
            "name",
            "contract_root"
          ],
          "outputs": [
            "boolean existed"
          ],
          "side_effects": [
            "removes one validated registered path"
          ],
          "cleanup": "self-verifying"
        },
        {
          "name": "cleanup_workspace",
          "inputs": [
            "state_root",
            "expected_state_id",
            "contract_root"
          ],
          "outputs": [
            "CleanupReport"
          ],
          "side_effects": [
            "removes validated registered state on Linux or macOS",
            "fails on unsafe targets, symlink escape, or residue"
          ],
          "cleanup": "terminal cleanup function"
        }
      ]
    },
    {
      "module": "ci_workflows.tooling",
      "trust_class": "shared-foundation",
      "functions": [
        {
          "name": "verify_tool",
          "inputs": [
            "tool_id",
            "contract_root"
          ],
          "outputs": [
            "ToolEvidence"
          ],
          "side_effects": [
            "executes a contract-selected version command"
          ],
          "cleanup": "none"
        },
        {
          "name": "verify_tool_set",
          "inputs": [
            "tool_set",
            "contract_root"
          ],
          "outputs": [
            "ToolSetEvidence"
          ],
          "side_effects": [
            "verifies contract-selected tools"
          ],
          "cleanup": "none"
        },
        {
          "name": "verify_runtime_capability",
          "inputs": [
            "capability_profile",
            "declared_os",
            "declared_architecture",
            "contract_root"
          ],
          "outputs": [
            "RuntimeCapabilityEvidence"
          ],
          "side_effects": [
            "verifies actual OS and architecture against one semantic contract profile",
            "compares GitHub-declared OS and architecture when present without emitting host identity or executable paths"
          ],
          "cleanup": "none"
        },
        {
          "name": "verify_checksum",
          "inputs": [
            "path",
            "algorithm",
            "expected"
          ],
          "outputs": [
            "verified checksum"
          ],
          "side_effects": [],
          "cleanup": "none"
        },
        {
          "name": "verify_digest",
          "inputs": [
            "path",
            "expected_digest"
          ],
          "outputs": [
            "verified digest"
          ],
          "side_effects": [],
          "cleanup": "none"
        },
        {
          "name": "install_locked_asset",
          "inputs": [
            "asset_id",
            "destination_root",
            "contract_root"
          ],
          "outputs": [
            "InstalledAsset"
          ],
          "side_effects": [
            "downloads one contract-selected HTTPS asset",
            "verifies size and SHA-256 before atomic install"
          ],
          "cleanup": "registered tool path through cleanup_workspace"
        }
      ]
    },
    {
      "module": "ci_workflows.dependencies",
      "trust_class": "exact-source",
      "functions": [
        {
          "name": "checkout_private_dependency",
          "inputs": [
            "state_root",
            "repository",
            "admitted_sha",
            "dependency_id",
            "expected_subpath",
            "fetch_depth",
            "token",
            "contract_root"
          ],
          "outputs": [
            "DependencyResult"
          ],
          "side_effects": [
            "calls merged #7 exact checkout",
            "erases remotes and credential-bearing Git config",
            "verifies detached exact HEAD and expected subpath"
          ],
          "cleanup": "registered dependency path; immediate cleanup on partial failure and cleanup_workspace on terminal paths"
        }
      ]
    },
    {
      "module": "ci_workflows.policy",
      "trust_class": "shared-foundation",
      "functions": [
        {
          "name": "scan_tracked_repository",
          "inputs": [
            "root",
            "repository",
            "contract_root"
          ],
          "outputs": [
            "tracked count",
            "scanned count"
          ],
          "side_effects": [
            "reads tracked non-binary files within configured size bounds"
          ],
          "cleanup": "none"
        },
        {
          "name": "verify_clean_tree",
          "inputs": [
            "root"
          ],
          "outputs": [],
          "side_effects": [
            "reads complete tracked and untracked Git status"
          ],
          "cleanup": "none"
        },
        {
          "name": "verify_generated_outputs",
          "inputs": [
            "root",
            "contract_root"
          ],
          "outputs": [
            "generated output count"
          ],
          "side_effects": [
            "verifies configured generated outputs have no diff"
          ],
          "cleanup": "none"
        },
        {
          "name": "validate_artifacts",
          "inputs": [
            "artifacts",
            "exception_id",
            "trust_mode",
            "contract_root"
          ],
          "outputs": [
            "validated exception id"
          ],
          "side_effects": [],
          "cleanup": "none"
        },
        {
          "name": "validate_cache_request",
          "inputs": [
            "mode",
            "repository",
            "source_sha",
            "lock_digest",
            "platform",
            "profile",
            "trust_mode",
            "contract_root"
          ],
          "outputs": [
            "CacheDecision"
          ],
          "side_effects": [],
          "cleanup": "cache transport remains caller-owned and disabled by default"
        },
        {
          "name": "verify_repository_policy",
          "inputs": [
            "root",
            "repository",
            "phase",
            "artifact_manifest_json",
            "artifact_exception_id",
            "trust_mode",
            "contract_root"
          ],
          "outputs": [
            "PolicyReport"
          ],
          "side_effects": [
            "runs the central clean-tree, tracked-secret, forbidden-file, generated-output, and artifact gate"
          ],
          "cleanup": "none"
        }
      ]
    },
    {
      "module": "ci_workflows.evidence",
      "trust_class": "shared-foundation",
      "functions": [
        {
          "name": "redact_text",
          "inputs": [
            "value",
            "contract_root"
          ],
          "outputs": [
            "redacted text"
          ],
          "side_effects": [],
          "cleanup": "none"
        },
        {
          "name": "build_evidence",
          "inputs": [
            "source_sha",
            "workflow_release",
            "runner_profile",
            "toolchain",
            "command_profile",
            "result",
            "cleanup_state",
            "cleanup_removed_paths",
            "contract_root"
          ],
          "outputs": [
            "EvidenceResult"
          ],
          "side_effects": [],
          "cleanup": "none"
        },
        {
          "name": "write_evidence",
          "inputs": [
            "state_root",
            "evidence"
          ],
          "outputs": [
            "Path"
          ],
          "side_effects": [
            "atomically writes canonical evidence beneath the registered evidence root"
          ],
          "cleanup": "cleanup_workspace"
        }
      ]
    }
  ],
  "actions": [
    {
      "path": "actions/prepare-workspace",
      "function": "ci_workflows.workspace.prepare_workspace",
      "inputs": [
        "profile",
        "cache_mode",
        "source_sha",
        "lock_digest",
        "trust_mode"
      ],
      "outputs": [
        "state_id",
        "profile",
        "cache_mode",
        "cache_key",
        "registered_path_count"
      ],
      "cleanup": "must pair with actions/cleanup-workspace under if: always()"
    },
    {
      "path": "actions/verify-toolchain",
      "function": "ci_workflows.tooling.verify_tool_set or install_locked_asset",
      "inputs": [
        "operation",
        "tool_set",
        "asset_id",
        "capability_profile"
      ],
      "outputs": [
        "tool_set",
        "toolchain_json",
        "toolchain_id",
        "capability_profile",
        "platform",
        "capability_id",
        "capability_verified",
        "asset_id",
        "asset_relative_path",
        "asset_sha256",
        "verified"
      ],
      "cleanup": "installed assets are registered under the workflow state root"
    },
    {
      "path": "actions/checkout-private-dependency",
      "function": "ci_workflows.dependencies.checkout_private_dependency",
      "inputs": [
        "repository",
        "admitted_sha",
        "dependency_id",
        "expected_subpath",
        "fetch_depth",
        "token"
      ],
      "outputs": [
        "dependency_id",
        "repository",
        "head_sha",
        "relative_path",
        "expected_subpath",
        "remotes_erased",
        "credentials_erased",
        "verified"
      ],
      "cleanup": "registered dependency path; cleanup-workspace required under if: always()"
    },
    {
      "path": "actions/verify-repository-policy",
      "function": "ci_workflows.policy.verify_repository_policy",
      "inputs": [
        "phase",
        "artifacts_json",
        "artifact_exception_id",
        "trust_mode"
      ],
      "outputs": [
        "phase",
        "tracked_files",
        "scanned_files",
        "generated_outputs",
        "artifact_count",
        "artifact_exception_id",
        "policy_evidence_id",
        "verified"
      ],
      "cleanup": "none; the action mutates no caller source"
    },
    {
      "path": "actions/render-evidence",
      "function": "ci_workflows.evidence.build_evidence and write_evidence",
      "inputs": [
        "source_sha",
        "workflow_release",
        "runner_profile",
        "toolchain_json",
        "command_profile",
        "result",
        "cleanup_state",
        "cleanup_removed_paths"
      ],
      "outputs": [
        "evidence_id",
        "evidence_json",
        "redacted"
      ],
      "cleanup": "evidence file is registered state and must be removed by cleanup-workspace"
    },
    {
      "path": "actions/cleanup-workspace",
      "function": "ci_workflows.workspace.cleanup_workspace",
      "inputs": [],
      "outputs": [
        "state_id",
        "removed_paths",
        "removed_sensitive_paths",
        "partial_setup",
        "platform",
        "cleanup_verified"
      ],
      "cleanup": "terminal action; invoke under if: always()"
    }
  ],
  "integration_constraints": [
    "Prepare the workspace before tool installation, dependency checkout, evidence writing, or cleanup.",
    "Invoke cleanup-workspace under if: always(); never pass a caller-selected deletion path.",
    "Pass only a full SHA admitted by source.resolve into checkout-private-dependency.",
    "Caching is disabled unless an allowed mode, trust mode, exact source SHA, lock digest, platform, and profile are supplied.",
    "Action pins remain authoritative in the merged #5 contracts/action-tool-lock.json; tool versions and downloadable asset digests are authoritative in contracts/tool-lock.json.",
    "Routine Actions artifacts are zero; any exception must exist in contracts/artifact-exceptions.json.",
    "Product commands remain checked-in consumer scripts selected outside these primitives.",
    "#31 may converge package and command names but must preserve these public functions and side-effect boundaries or record a reviewed compatibility change."
  ]
}
