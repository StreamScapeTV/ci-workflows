{
  "schema_version": 1,
  "contract_version": "2.0.0",
  "organization": "StreamScapeTV",
  "workflow_api": "validation.python",
  "stable_check_name": "CI / Python validation",
  "hard_timeout_minutes": 120,
  "cache_mode": "disabled",
