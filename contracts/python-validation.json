  "profiles": {
    "audit": {"runner_profile":"portable","timeout_minutes":20,"workspace_profile":"minimal","isolation":"copied-host-source","postgres":false,"dependency_mode":"none","runtime_kind":"host","allowed_source_trust":["untrusted-fork","trusted-pr","trusted-exact"]},
    "host": {"runner_profile":"portable","timeout_minutes":60,"workspace_profile":"minimal","isolation":"copied-host-source","postgres":false,"dependency_mode":"locked-optional","runtime_kind":"host","allowed_source_trust":["trusted-pr","trusted-exact"]},
    "podman": {"runner_profile":"buildah-high","timeout_minutes":90,"workspace_profile":"container","isolation":"podman-vfs","postgres":false,"dependency_mode":"locked-optional","runtime_kind":"container","allowed_source_trust":["trusted-exact"]},
    "podman-postgres": {"runner_profile":"buildah-medium","timeout_minutes":90,"workspace_profile":"container","isolation":"podman-vfs-postgres","postgres":true,"dependency_mode":"locked-optional","runtime_kind":"container","allowed_source_trust":["trusted-exact"]}
  },
  "runtimes": {
    "host-cpython-3.12": {"kind":"host","implementation":"cpython","python_version":"3.12","platforms":["linux/x64"]},
    "python-3.12.8-slim-amd64": {"kind":"container","repository":"docker.io/library/python","tag":"3.12.8-slim","digest":"sha256:d0af71d7d6d1b7bb018395aca582e4d270d090ca41312ae5318341f122fec6b8","python_version":"3.12.8","platform":"linux/amd64"},
    "python-3.12.13-slim-amd64": {"kind":"container","repository":"docker.io/library/python","tag":"3.12.13-slim","digest":"sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de","python_version":"3.12.13","platform":"linux/amd64"},
    "postgres-16.11-alpine-amd64": {"kind":"postgres","repository":"docker.io/library/postgres","tag":"16.11-alpine","digest":"sha256:63cf43b1a12b5b9d1f7a576f8f5852d7ce0792618661969135ac6c276237eec9","postgres_version":"16.11","postgres_major":16,"platform":"linux/amd64"}
  },
  "python_versions": {"host":["3.12"],"container":["3.12.8","3.12.13"]},
  "script_contract": {"path_mode":"repository-relative-executable","arguments":"none","environment":"generic-only","maximum_path_length":240},
  "postgres": {"runtime":"postgres-16.11-alpine-amd64","username":"ci_python","database":"ci_python","network_alias":"postgres","connection_environment_variable":"CIW_POSTGRES_URL","connection_url_scheme":"postgresql","credentials":"ephemeral-per-execution","remote_fallback":false,"readiness_attempts":30,"readiness_interval_seconds":2,"readiness_timeout_seconds":60},
