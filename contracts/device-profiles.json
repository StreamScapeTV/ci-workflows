{
  "schema_version": 1,
  "contract_version": "1.1.0",
  "organization": "StreamScapeTV",
  "workflow_api": "validation.device",
  "stable_check_name": "CI / Physical device validation",
  "planner_runner_profile": "portable",
  "execution_overlay_profile": "physical-device",
  "hard_timeout_minutes": 240,
  "artifact_policy": "zero-default",
  "request_id_regex": "^issue-([1-9][0-9]*)-([a-z0-9][a-z0-9-]{7,63})$",
  "run_id_regex": "^[1-9][0-9]{0,19}:[1-9][0-9]{0,3}$",
  "allowed_derived_source_trust": [
    "trusted-exact"
  ],
  "allowed_events": [
    "workflow_call",
    "workflow_dispatch"
  ],
  "synthetic_allowed_event": "pull_request",
  "synthetic_derived_source_trust": "trusted-pr",
  "families": [
    "android",
    "ios",
    "tvos"
  ],
  "public_inputs": [
    "admitted_sha",
    "device_family",
    "device_capability",
    "device_alias",
    "command_profile",
    "script_path",
    "max_duration_minutes",
    "evidence_exception_id",
    "request_id"
  ],
  "public_outputs": [
    "result",
    "device_evidence_id",
    "artifact_exception_used",
    "request_id"
  ],
  "public_secrets": [
    "device_authorization_receipt",
    "live_test_credentials"
  ],
  "forbidden_inputs": [
    "arbitrary_command",
    "arguments",
    "callback",
    "command",
    "database_url",
    "deletion_path",
    "deployment",
    "device_identifier",
    "device_selector",
    "environment_dump",
    "keychain",
    "keystore",
    "kubernetes",
    "live_backend_url",
    "notarization",
    "physical_device",
    "production_endpoint",
    "provisioning_profile",
    "raw_identifier",
    "registry",
    "release",
    "runner",
    "runner_labels",
    "runs_on",
    "secret_name",
    "serial",
    "shell",
    "signing_identity",
    "source_trust",
    "store",
    "testflight",
    "udid",
    "workspace_root",
    "concurrency_group",
    "cancel_in_progress"
  ],
  "failure_codes": [
    "artifact_exception_rejected",
    "authorization_rejected",
    "cleanup_failed",
    "command_profile_rejected",
    "device_conflict",
    "device_disconnected",
    "device_family_mismatch",
    "device_inventory_malformed",
    "device_multiple_matches",
    "device_no_match",
    "device_offline",
    "device_profile_rejected",
    "device_restoration_failed",
    "evidence_overclaim",
    "evidence_policy_failed",
    "forbidden_input",
    "group_injection_rejected",
    "invalid_input",
    "live_backend_rejected",
    "lock_collision",
    "lock_release_failed",
    "lock_stale_epoch",
    "physical_authorization_required",
    "prepare_failed",
    "request_identity_rejected",
    "source_admission_rejected",
    "source_mismatch",
    "stage_failed",
    "typed_plan_hash_mismatch",
    "typed_plan_rejected",
    "unsupported_family"
  ],
  "serialization_contract": {
    "backend": "github-actions-job-concurrency",
    "caller_override": false,
    "cancel_in_progress": false,
    "fencing_token": true,
    "group_scope": [
      "device_profile",
      "device_family",
      "alias_class"
    ]
  },
  "owner_authorization": {
    "mode": "exact-family-runtime-receipt",
    "authorized_families": [],
    "runner_or_secret_is_authorization": false,
    "failure_code": "physical_authorization_required"
  },
  "lock_contract": {
    "agent_state_transport_used": false,
    "cross_run_fencing_claimed": true,
    "production_adapter": "device-lock/1:posix-shared-root-v1",
    "temporary_reference_adapter": "in-memory-tests-only"
  },
  "cleanup": {
    "reject_symlink_follow": true,
    "remove_central_checkout": true,
    "remove_local_outputs": true,
    "remove_owned_temporary_install": true,
    "remove_registered_workspace": true,
    "remove_workflow_credentials": true,
    "restore_captured_state": true,
    "terminate_owned_application": true,
    "zero_routine_artifacts": true
  },
  "artifact_exceptions": {
    "redacted-device-diagnostics": {
      "allowed_media_types": [
        "application/json",
        "text/plain"
      ],
      "forbidden_extensions": [
        ".apk",
        ".aab",
        ".ipa",
        ".mobileprovision",
        ".p12",
        ".keychain-db",
        ".mov",
        ".mp4"
      ],
      "maximum_bytes": 8388608,
      "maximum_files": 12,
      "redaction_required": true,
      "retention_days": 3
    }
  },
  "live_backend_profiles": {
    "android-test-backend": {
      "allowed_repositories": [
        "StreamScapeTV/iptv-android"
      ],
      "production_forbidden": true,
      "secret_contract": "live_test_credentials"
    },
    "apple-test-backend": {
      "allowed_repositories": [
        "StreamScapeTV/iptv-apple"
      ],
      "production_forbidden": true,
      "secret_contract": "live_test_credentials"
    }
  },
  "command_profiles": {
    "ciw-device-synthetic": {
      "prepare_script": "tests/fixtures/device-validation/scripts/prepare.sh",
      "test_script": "tests/fixtures/device-validation/scripts/test.sh",
      "evidence_script": "tests/fixtures/device-validation/scripts/evidence.sh",
      "cleanup_script": "tests/fixtures/device-validation/scripts/cleanup.sh",
      "fixed_arguments": [],
      "live_backend_profile": null,
      "state_restoration": [
        "terminate-owned-test",
        "remove-owned-install",
        "restore-captured-state"
      ]
    },
    "iptv-android-device": {
