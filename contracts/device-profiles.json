{
  "schema_version": 1,
  "contract_version": "2.0.0",
  "organization": "StreamScapeTV",
  "workflow_api": "validation.device",
  "stable_check_name": "CI / Physical device validation",
  "planner_runner_profile": "portable",
  "execution_overlay_profile": "physical-device",
  "hard_timeout_minutes": 240,
  "artifact_policy": "zero-default",
  "request_id_regex": "^issue-([1-9][0-9]*)-([a-z0-9][a-z0-9-]{7,63})$",
  "run_id_regex": "^[1-9][0-9]{0,19}:[1-9][0-9]{0,3}$",
  "allowed_derived_source_trust": ["trusted-exact"],
  "allowed_events": ["pull_request", "workflow_call", "workflow_dispatch"],
  "synthetic_allowed_events": ["pull_request", "push", "workflow_dispatch"],
  "synthetic_derived_source_trust": "trusted-pr",
  "families": ["android", "ios", "tvos"],
  "public_inputs": [
    "admitted_sha",
    "device_family",
    "device_capability",
    "host_capacity",
    "prepare_script_path",
    "test_script_path",
    "evidence_script_path",
    "cleanup_script_path",
    "arguments_json",
    "environment_json",
    "max_duration_minutes",
    "evidence_exception_id",
    "request_id"
  ],
  "public_outputs": ["result", "device_evidence_id", "artifact_exception_used", "request_id"],
  "public_secrets": ["device_authorization_receipt"],
  "forbidden_inputs": [
    "arbitrary_command", "arguments", "callback", "cancel_in_progress", "command",
    "command_profile", "concurrency_group", "database_url", "deletion_path", "deployment",
    "device_alias", "device_identifier", "device_selector", "environment_dump", "execution_backend", "keychain",
    "keystore", "kubernetes", "live_backend_url", "notarization", "physical_device",
    "production_endpoint", "provisioning_profile", "raw_identifier", "registry", "release",
    "runner", "runner_labels", "runs_on", "script_path", "secret_name", "serial", "shell",
    "signing_identity", "source_trust", "store", "testflight", "udid", "workspace_root"
  ],
  "failure_codes": [
    "artifact_exception_rejected", "authorization_rejected", "cleanup_failed",
    "command_profile_rejected", "device_conflict", "device_disconnected",
    "device_family_mismatch", "device_inventory_malformed", "device_multiple_matches",
    "device_no_match", "device_offline", "device_profile_rejected",
    "device_restoration_failed", "evidence_overclaim", "evidence_policy_failed",
    "forbidden_input", "group_injection_rejected", "invalid_input", "lock_collision",
    "lock_release_failed", "lock_stale_epoch", "physical_authorization_required",
    "prepare_failed", "request_identity_rejected", "source_admission_rejected",
    "source_mismatch", "stage_failed", "typed_plan_hash_mismatch", "typed_plan_rejected",
    "unsupported_family"
  ],
  "serialization_contract": {
    "backend": "github-actions-job-concurrency",
    "caller_override": false,
    "cancel_in_progress": false,
    "fencing_token": true,
    "group_scope": ["device_family", "device_capability", "host_capacity"]
  },
  "owner_authorization": {
    "mode": "exact-family-runtime-receipt",
    "authorized_families": [],
    "runner_or_secret_is_authorization": false,
    "failure_code": "physical_authorization_required"
  },
  "lock_contract": {
    "agent_state_transport_used": false,
    "cross_run_fencing_claimed": true,
    "production_adapter": "device-lock/1:posix-shared-root-v1",
    "temporary_reference_adapter": "in-memory-tests-only"
  },
  "cleanup": {
    "reject_symlink_follow": true,
    "remove_central_checkout": true,
    "remove_local_outputs": true,
    "remove_owned_temporary_install": true,
    "remove_registered_workspace": true,
    "remove_workflow_credentials": true,
    "restore_captured_state": true,
    "terminate_owned_application": true,
    "zero_routine_artifacts": true
  },
  "artifact_exceptions": {
    "redacted-device-diagnostics": {
      "allowed_media_types": ["application/json", "text/plain"],
      "forbidden_extensions": [".apk", ".aab", ".ipa", ".mobileprovision", ".p12", ".keychain-db", ".mov", ".mp4"],
      "maximum_bytes": 8388608,
      "maximum_files": 12,
      "redaction_required": true,
      "retention_days": 3
    }
  },
  "physical_host_constraints": {
    "apple": {
      "families": ["ios", "tvos"],
      "semantic_profile": "apple",
      "capacity_owner": "organization-manual",
      "lifecycle": "organization-managed-persistent-capacity",
      "manual_capacity": true,
      "exact_selector": ["macOS", "ARM64"]
    }
  },
  "family_policies": {
    "android": {
      "models": ["phone", "tablet", "television"],
      "version_policy": {"api_min": 29, "api_max": 37},
      "selection_policy": "unique",
      "allowed_host_capacities": ["mobile", "apple"],
      "workspace_profiles": {"mobile": "native", "apple": "apple"},
      "timeout_minutes": 180,
      "artifact_exception_ids": ["redacted-device-diagnostics"],
      "connection_states": ["usb"],
      "health_states": ["online"]
    },
    "ios": {
      "models": ["iphone", "ipad"],
      "version_policy": {"os_min": "17.0", "os_max": "26.5"},
      "selection_policy": "unique",
      "allowed_host_capacities": ["apple"],
      "workspace_profiles": {"apple": "apple"},
      "timeout_minutes": 180,
      "artifact_exception_ids": ["redacted-device-diagnostics"],
      "connection_states": ["usb", "paired"],
      "health_states": ["online"]
    },
    "tvos": {
      "models": ["apple-tv"],
      "version_policy": {"os_min": "17.0", "os_max": "26.5"},
      "selection_policy": "unique",
      "allowed_host_capacities": ["apple"],
      "workspace_profiles": {"apple": "apple"},
      "timeout_minutes": 180,
      "artifact_exception_ids": ["redacted-device-diagnostics"],
      "connection_states": ["usb", "paired"],
      "health_states": ["online"]
    }
  }
}
