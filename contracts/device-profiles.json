      "live_backend_profile": null,
      "prepare_script": "tests/fixtures/device-validation/scripts/prepare.sh",
      "state_restoration": [
        "terminate-owned-test",
        "remove-owned-install",
        "restore-captured-state"
      ],
      "test_script": "tests/fixtures/device-validation/scripts/test.sh"
    },
