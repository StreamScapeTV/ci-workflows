{
  "schema_version": 1,
  "tools": {
    "python": {
      "executable": "python3",
      "version_args": [
        "--version"
      ],
      "version_pattern": "Python ([0-9]+\\.[0-9]+\\.[0-9]+)",
      "minimum_version": "3.11.0",
      "version_policy": "minimum"
    },
    "git": {
      "executable": "git",
      "version_args": [
        "--version"
      ],
      "version_pattern": "git version ([0-9]+\\.[0-9]+\\.[0-9]+)",
      "minimum_version": "2.30.0",
      "version_policy": "minimum"
    },
    "bash": {
      "executable": "bash",
      "version_args": [
        "--version"
      ],
      "version_pattern": "GNU bash, version ([0-9]+\\.[0-9]+\\.[0-9]+)",
      "minimum_version": "3.2.0",
      "version_policy": "minimum"
    },
    "buildah": {
      "executable": "buildah",
      "version_args": [
        "--version"
      ],
      "version_pattern": "buildah version ([0-9]+\\.[0-9]+\\.[0-9]+)",
      "required_version": "1.33.7",
      "version_policy": "exact"
    },
    "skopeo": {
      "executable": "skopeo",
      "version_args": [
        "--version"
      ],
      "version_pattern": "skopeo version ([0-9]+\\.[0-9]+\\.[0-9]+)",
      "required_version": "1.13.3",
      "version_policy": "exact"
    },
    "podman": {
      "executable": "podman",
      "version_args": [
        "--version"
      ],
      "version_pattern": "podman version ([0-9]+\\.[0-9]+\\.[0-9]+)",
      "required_version": "4.9.3",
      "version_policy": "exact"
    }
  },
  "tool_sets": {
    "baseline": [
      "python",
      "git",
      "bash"
    ],
    "checkout": [
      "python",
      "git"
    ],
    "policy": [
      "python",
      "git"
    ],
    "oci-builder": [
      "buildah",
      "skopeo",
      "podman"
    ]
  },
  "assets": {},
  "download_policy": {
    "allowed_scheme": "https",
    "maximum_bytes": 104857600,
    "required_digest": "sha256",
    "redirect_host_must_match": true,
    "mutable_fallback_forbidden": true
  },
  "capability_profiles": {
    "baseline": {
      "operating_systems": [
        "Linux",
        "macOS"
      ],
      "architectures": [
        "x64",
        "arm64"
      ]
    },
    "linux": {
      "operating_systems": [
        "Linux"
      ],
      "architectures": [
        "x64",
        "arm64"
      ]
    },
    "macos": {
      "operating_systems": [
        "macOS"
      ],
      "architectures": [
        "x64",
        "arm64"
      ]
    }
  }
}
