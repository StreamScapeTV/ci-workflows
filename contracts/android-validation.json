{
  "schema_version": 1,
  "contract_version": "1.0.0",
  "organization": "StreamScapeTV",
  "workflow_api": "validation.android",
  "stable_check_name": "CI / Android validation",
  "planner_runner_profile": "portable",
  "execution_runner_profile": "mobile",
  "hard_timeout_minutes": 120,
  "cache_mode": "disabled",
  "artifact_policy": "zero-default",
  "toolchain": {
    "java_major": 25,
    "javac_major": 25,
    "android_api": 37,
    "command_line_tools_version": "14742923",
    "packages": [
      "platform-tools",
      "platforms;android-37.0",
      "build-tools;37.0.0"
    ],
    "build_tools_version": "37.0.0",
    "locale": "C.UTF-8",
    "gradle_daemon": false
  },
  "profiles": {
    "toolchain-smoke": {
      "timeout_minutes": 15,
      "requires_gradle": false,
      "allows_private_dependency": false,
      "output_mode": "none",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "compile": {
      "timeout_minutes": 45,
      "requires_gradle": true,
      "allows_private_dependency": true,
      "output_mode": "none",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "unit-targeted": {
      "timeout_minutes": 45,
      "requires_gradle": true,
      "allows_private_dependency": true,
      "output_mode": "test",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "unit-full": {
      "timeout_minutes": 75,
      "requires_gradle": true,
      "allows_private_dependency": true,
      "output_mode": "test",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "performance": {
      "timeout_minutes": 60,
      "requires_gradle": true,
      "allows_private_dependency": true,
      "output_mode": "test",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "lint": {
      "timeout_minutes": 60,
      "requires_gradle": true,
      "allows_private_dependency": true,
      "output_mode": "lint",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "assemble-debug": {
      "timeout_minutes": 75,
      "requires_gradle": true,
      "allows_private_dependency": true,
      "output_mode": "debug-unsigned",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "room-schema": {
      "timeout_minutes": 60,
      "requires_gradle": true,
      "allows_private_dependency": true,
      "output_mode": "schema",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "consumer-script": {
      "timeout_minutes": 90,
      "requires_gradle": false,
      "allows_private_dependency": false,
      "output_mode": "consumer-owned",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    },
    "device-handoff": {
      "timeout_minutes": 10,
      "requires_gradle": false,
      "allows_private_dependency": false,
      "output_mode": "handoff-only",
      "allowed_source_trust": [
        "trusted-pr",
        "trusted-exact"
      ]
    }
  },
  "private_dependencies": {
    "streamscape-media-android-v1": {
      "repository": "StreamScapeTV/streamscape-media",
      "allowed_shas": [
        "85b3c7ed9711fa6ac53059e5d3e474d791c45d26"
      ],
      "expected_subdirectory": "android",
      "required_paths": [
        "android/settings.gradle.kts",
        "android/gradlew"
      ],
      "allowed_consumers": [
        "StreamScapeTV/iptv-android"
      ],
      "dependency_id": "streamscape-media-android",
      "environment": {
        "STREAMSCAPE_MEDIA_LOCAL_REPO": "root",
        "STREAMSCAPE_MEDIA_INCLUDE_BUILD": "subdirectory",
        "STREAMSCAPE_MEDIA_SHA": "sha"
      }
    }
  },
  "artifact_exceptions": {
    "android-redacted-diagnostics-v1": {
      "allowed_profiles": [
        "compile",
        "unit-targeted",
        "unit-full",
        "performance",
        "lint",
        "room-schema",
        "consumer-script"
      ],
      "allowed_patterns": [
        "build-logs/**/*.log",
        "**/build/test-results/**/*.xml",
        "**/build/reports/lint-results-*.xml",
        "build/reports/room-schema-json-integrity.json"
      ],
      "forbidden_extensions": [
        ".apk",
        ".aab",
        ".jks",
        ".keystore"
      ],
      "maximum_files": 200,
      "maximum_bytes": 16777216,
      "retention_days": 3
    }
  },
  "device_handoff": {
    "families": [
      "android-phone",
      "android-tv"
    ],
    "request_id_regex": "^[a-z][a-z0-9-]{2,63}$",
    "output_fields": [
      "contract_version",
      "source_sha",
      "device_family",
      "request_id",
      "status"
    ],
    "status": "handoff-requested"
  },
  "test_selector_regex": "^[A-Za-z_][A-Za-z0-9_$]*(?:\\.[A-Za-z_][A-Za-z0-9_$]*){2,31}$",
  "fixed_gradle_arguments": [
    "--no-daemon",
    "--console=plain",
    "--warning-mode=all",
    "--stacktrace"
  ],
  "forbidden_argument_fragments": [
    ";",
    "&&",
    "||",
    "`",
    "$(",
    "${",
    "\n",
    "\r",
    "--init-script",
    "-I",
    "--project-prop",
    "-P",
    "--system-prop",
    "-D",
    "--gradle-user-home",
    "-g",
    "--project-dir",
    "-p"
  ],
  "generated_cleanup_names": [
    ".gradle",
    ".android",
    "build",
    "build-logs",
    "reports",
    "test-results",
    "outputs",
    ".tools",
    ".tmp",
    "local.properties",
    "__pycache__"
  ],
  "failure_codes": [
    "invalid_input",
    "unsupported_profile",
    "source_trust_rejected",
    "source_mismatch",
    "toolchain_mismatch",
    "sdk_package_missing",
    "wrapper_invalid",
    "wrapper_distribution_drift",
    "task_profile_rejected",
    "test_filter_rejected",
    "private_dependency_rejected",
    "private_dependency_missing",
    "private_dependency_dirty",
    "command_failed",
    "compile_failed",
    "tests_failed",
    "performance_failed",
    "lint_failed",
    "assemble_failed",
    "schema_drift",
    "consumer_script_failed",
    "debug_output_invalid",
    "artifact_policy_failed",
    "dirty_tree",
    "cleanup_failed"
  ],
  "forbidden_inputs": [
    "arbitrary_task",
    "arbitrary_command",
    "arguments",
    "shell",
    "callback",
    "jdk_url",
    "sdk_url",
    "runner",
    "runs_on",
    "runner_labels",
    "matrix",
    "container_engine",
    "docker",
    "podman",
    "registry",
    "signing_identity",
    "keystore",
    "play_store",
    "secret_name",
    "database_url",
    "backend_url",
    "physical_device",
    "device_selector",
    "deployment",
    "mutable_ref",
    "artifact_upload",
    "release",
    "helm",
    "flux_target"
  ],
  "cleanup": {
    "always_required": true,
    "remove_gradle_state": true,
    "remove_android_state": true,
    "remove_build_outputs": true,
    "remove_logs": true,
    "remove_private_dependency": true,
    "remove_sdk_probes": true,
    "remove_generated_schemas": true,
    "verify_no_daemons": true,
    "verify_source_clean": true,
    "verify_zero_artifacts": true,
    "no_follow": true,
    "caller_deletion_path_forbidden": true
  },
  "wrappers": {
    "central-smoke-gradle-9.6.1": {
      "mode": "synthetic-smoke",
      "version": "9.6.1",
      "properties_path": "gradle/wrapper/gradle-wrapper.properties",
      "distribution_url": "https://services.gradle.org/distributions/gradle-9.6.1-bin.zip",
