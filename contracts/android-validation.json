      "distribution_url": "https://services.gradle.org/distributions/gradle-9.6.1-bin.zip",
      "distribution_sha256": "9c0f7faeeb306cb14e4279a3e084ca6b596894089a0638e68a07c945a32c9e14",
      "tracked_blob_sha1": "4ede28f399514aae191c87886645ee5d46fcc77b",
      "properties_blob_sha1": "da32a7e2ea3edde7cc2bfb520dc260db68c0eb66"
    }
  },
