{
  "schema_version": 1,
  "organization": "StreamScapeTV",
  "contract_version": "1.0.0",
  "workflow_inventory_path": "contracts/workflow-inventory.json",
  "artifact_exceptions_path": "contracts/artifact-exceptions.json",
  "maintenance_runner_selector": [
    "linux",
    "amd64",
    "general"
  ],
  "flux_runner_selector": [
    "linux",
    "amd64",
    "flux-control"
  ],
  "request_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$",
  "projects": [
    {"project_id":"ci-workflows","repository":"StreamScapeTV/ci-workflows","integration_branch":"main"},
    {"project_id":"iptv-backend","repository":"StreamScapeTV/iptv-backend","integration_branch":"main"},
    {"project_id":"StreamScapeWeb","repository":"StreamScapeTV/StreamScapeWeb","integration_branch":"main"},
    {"project_id":"iptv-android","repository":"StreamScapeTV/iptv-android","integration_branch":"develop"},
    {"project_id":"iptv-apple","repository":"StreamScapeTV/iptv-apple","integration_branch":"develop"},
    {"project_id":"streamscape-media","repository":"StreamScapeTV/streamscape-media","integration_branch":"develop"},
    {"project_id":"directus-front","repository":"StreamScapeTV/directus-front","integration_branch":"main"},
    {"project_id":"finance-hub","repository":"StreamScapeTV/finance-hub","integration_branch":"main"},
    {"project_id":"agent-state","repository":"StreamScapeTV/agent-state","integration_branch":"main"},
    {"project_id":"flux","repository":"StreamScapeTV/flux","integration_branch":"main"},
    {"project_id":"organization-rules","repository":"StreamScapeTV/organization-rules","integration_branch":"main"}
  ],
  "operations": {
    "artifacts": {"dry_run_default":true,"minimum_age_hours":2,"maximum_deletions":100,"recommended_schedule":"17,47 * * * *","credential":"organization_maintenance_token"},
    "branches": {"dry_run_default":true,"branch_prefix":"issue/","require_exact_merged_pull_request":true,"credential":"organization_maintenance_token"},
    "conformance": {"dry_run_default":true,"report_repository":"StreamScapeTV/ci-workflows","report_title_prefix":"Organization conformance","maximum_findings":500,"credential_read":"organization_read_token","credential_update":"organization_update_token"},
    "runner_retry": {"dry_run_default":true,"maximum_failed_jobs":20,"maximum_log_bytes":2097152,"allowed_inventory_trust":["read"],"allowed_events":["pull_request","push","workflow_dispatch"],"credential":"organization_maintenance_token","infrastructure_signatures":["lost communication with the runner","the runner has received a shutdown signal","runner listener exited unexpectedly","the self-hosted runner was lost","the runner was removed before this job could start","the runner registration has been deleted"],"product_failure_signatures":["process completed with exit code","assertionerror","tests failed","test failed","compilation failed","compiler error","lint failed","security scan failed","dependency failed","exceeded the maximum execution time","manually canceled","manually cancelled"]},
    "flux_reconcile": {"dry_run_default":true,"repository":"StreamScapeTV/flux","allowed_operations":["deploy","restart"],"policy_path":"scripts/rollout/validate_request.py","allowlist_path":".github/flux-rollout-allowlist.json","executor_path":"scripts/rollout/execute_request.py","policy_interface":"central-flux-policy-v1","credentials":["flux_kubeconfig","flux_sops_age_key"],"live_mutation_requires_flux_owned_authorization":true}
  },
  "retired_boundaries": {
    "agent_state_transport": ["agent-state-claim","agent-state-lifecycle","agent-state-ownership","receipt","compatibility dispatcher"],
    "forbidden_behavior": ["force-push","delete-unmerged-branch","delete-protected-branch","retry-product-failure","arbitrary-shell","arbitrary-callback","hardcoded-flux-target","hardcoded-cluster-credential"]
  }
}
