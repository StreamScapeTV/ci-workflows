{
  "schema_version": 1,
  "max_inline_run_lines": 40,
  "max_matrix_jobs": 16,
  "max_timeout_minutes": 240,
  "allowed_runner_profiles": [
    "portable"
  ],
  "required_fixture_callers": [
    "ordinary-validation.yml",
    "tag-release.yml",
    "flux-source-validation.yml"
  ],
  "required_event_fixtures": [
    "push",
    "pull_request_fork",
    "workflow_call",
    "tag_push",
    "issue_comment",
    "pull_request_target",
    "workflow_run",
    "trusted_maintenance",
    "flux_reconciliation"
  ],
  "required_service_scenarios": {
    "github": ["positive", "retry", "replay", "conflict", "stale", "outage", "malicious_response"],
    "registry": ["positive", "retry", "replay", "conflict", "stale", "outage", "malicious_response"],
    "helm": ["positive", "retry", "replay", "conflict", "stale", "outage", "malicious_response"],
    "flux": ["positive", "retry", "replay", "conflict", "stale", "outage", "malicious_response"]
  },
  "exceptions": [
    {
      "path": ".github/workflows/reusable-tag-image-chart.yml",
      "issue": 34,
      "reason": "Bounded bootstrap publisher predates the named-function and semantic-runner architecture and remains frozen until its contracted replacement is implemented.",
      "rules": [
        "bare-self-hosted",
        "unknown-runner-profile",
        "oversized-inline-run",
        "complex-yaml-logic",
        "caller-cancelling-concurrency",
        "stable-check-drift",
        "public-api-doc-drift"
      ]
    }
  ]
}
