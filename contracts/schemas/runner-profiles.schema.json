{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscapetv.invalid/schemas/runner-profiles-v1.json",
  "title": "StreamScapeTV runner capability profiles",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "organization",
    "authority",
    "scheduling_mechanism",
    "direct_selection_policy",
    "source_trust_values",
    "profiles",
    "workflow_bindings",
    "compatibility_rules",
    "forbidden_selector_tokens",
    "caller_forbidden_fields",
    "buildah_escalation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"const": "1.0.0"},
    "organization": {"const": "StreamScapeTV"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_authority", "agent_reference", "flux_source", "apple_source"],
      "properties": {
        "implementation_authority": {"const": "contracts/runner-profiles.json"},
        "agent_reference": {"const": "RUNNERS.md"},
        "flux_source": {"type": "string", "minLength": 1},
        "apple_source": {"type": "string", "minLength": 1}
      }
    },
    "scheduling_mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "planner_profile", "description", "composite_action_can_change_runs_on", "caller_supplied_selectors", "generated_mapping"],
      "properties": {
        "kind": {"const": "trusted-planning-job"},
        "planner_profile": {"const": "portable"},
        "description": {"type": "string", "minLength": 1},
        "composite_action_can_change_runs_on": {"const": false},
        "caller_supplied_selectors": {"const": false},
        "generated_mapping": {"const": "generated/runner-mappings.json"}
      }
    },
    "direct_selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration_only", "bare_self_hosted_forbidden", "docker_and_dind_retired", "generic_buildah_maps_only_to", "consumer_infrastructure_identity_forbidden"],
      "properties": {
        "migration_only": {"const": true},
        "bare_self_hosted_forbidden": {"const": true},
        "docker_and_dind_retired": {"const": true},
        "generic_buildah_maps_only_to": {"const": "buildah-small"},
        "consumer_infrastructure_identity_forbidden": {"const": true}
      }
    },
    "source_trust_values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "profiles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/profile"}
    },
    "workflow_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["api", "strategy", "profiles"],
        "properties": {
          "api": {"type": "string", "minLength": 1},
          "strategy": {"enum": ["fixed", "platform", "guarded-overlay", "measured-tier", "product-contract-tier", "internal-multi-job"]},
          "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
        }
      }
    },
    "compatibility_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["migration", "profiles"],
        "properties": {
          "migration": {"type": "string", "minLength": 1},
          "profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
          "exception": {"type": "string", "minLength": 1}
        }
      }
    },
    "forbidden_selector_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "caller_forbidden_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "buildah_escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "required_evidence", "policy"],
      "properties": {
        "order": {"const": ["buildah-tiny", "buildah-small", "buildah-medium", "buildah-high"]},
        "required_evidence": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "policy": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "public_name",
        "kind",
        "public_labels",
        "internal_selectors",
        "default_internal_selector",
        "os",
        "architecture",
        "lifecycle",
        "capacity_owner",
        "privilege",
        "trust",
        "tools",
        "resources",
        "concurrency_cap",
        "allowed_workflow_apis",
        "forbidden_uses",
        "evidence_fields"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "public_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "kind": {"enum": ["runner", "guarded-overlay"]},
        "public_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "internal_selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
        "default_internal_selector": {"oneOf": [{"$ref": "#/$defs/selector"}, {"type": "null"}]},
        "base_profile_by_family": {
          "type": "object",
          "additionalProperties": false,
          "required": ["android", "ios", "tvos"],
          "properties": {
            "android": {"const": "mobile"},
            "ios": {"const": "apple"},
            "tvos": {"const": "apple"}
          }
        },
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "lifecycle": {"type": "string", "minLength": 1},
        "capacity_owner": {"type": "string", "minLength": 1},
        "privilege": {
          "type": "object",
          "additionalProperties": false,
          "required": ["privileged_container", "kubernetes_token", "repository_scoped", "manual_capacity", "device_locked"],
          "properties": {
            "privileged_container": {"type": "boolean"},
            "kubernetes_token": {"type": "boolean"},
            "repository_scoped": {"type": "boolean"},
            "manual_capacity": {"type": "boolean"},
            "device_locked": {"type": "boolean"}
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credential_baseline", "executes_caller_source", "allowed_source_trust"],
          "properties": {
            "credential_baseline": {"type": "string", "minLength": 1},
            "executes_caller_source": {"type": "boolean"},
            "allowed_source_trust": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory_request", "memory_limit", "local_storage_limit", "workspace", "scratch", "managed_cache"],
          "properties": {
            "memory_request": {"type": ["string", "null"]},
            "memory_limit": {"type": ["string", "null"]},
            "local_storage_limit": {"type": ["string", "null"]},
            "workspace": {"type": ["string", "null"]},
            "scratch": {"type": ["string", "null"]},
            "managed_cache": {"type": ["string", "null"]}
          }
        },
        "concurrency_cap": {"type": ["integer", "null"], "minimum": 1},
        "allowed_workflow_apis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "lock_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "required_fields"],
          "properties": {
            "required": {"const": true},
            "required_fields": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "forbidden_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "runner"}}},
          "then": {
            "properties": {
              "internal_selectors": {"minItems": 1},
              "default_internal_selector": {"$ref": "#/$defs/selector"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "guarded-overlay"}}},
          "then": {
            "required": ["base_profile_by_family", "lock_contract"],
            "properties": {
              "internal_selectors": {"maxItems": 0},
              "default_internal_selector": {"type": "null"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
