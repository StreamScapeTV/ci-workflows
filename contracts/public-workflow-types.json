{
  "schema_version": 1,
  "organization": "StreamScapeTV",
  "reference_policy": {
    "full_sha_pattern": "^[0-9a-f]{40}$",
    "semver_tag_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
    "immutable_references": ["full-sha", "immutable-semver-tag"],
    "bootstrap_mutable_reference": "main",
    "bootstrap_mutable_allowed_trust_classes": ["source-admission", "read-only-validation", "physical-device-validation", "trusted-publication"],
    "privileged_mutable_references_forbidden": false,
    "consumer_updates": "reviewable-pull-request"
  },
  "compatibility_policy": {
    "compatible": ["add workflow", "add optional input without behavior change", "add output", "widen documented technology capability without privilege change", "documentation clarification"],
    "conditional": ["tighten input validation within documented bounds", "change internal implementation or named function without public behavior change", "change timeout or matrix within published maximum", "deprecate with replacement and supported window"],
    "breaking": ["remove or rename workflow", "remove or rename input/output/secret/check", "add required input or secret", "change default behavior", "expand caller permissions", "change trust class or reference policy", "change semantic runner class incompatibly", "remove or narrow documented technology capability", "increase reusable-workflow depth"],
    "acknowledgement_required_fields": ["id", "api_name", "kind", "reason", "migration_issue", "effective_version"]
  },
  "defaults": {
    "evidence_policy": "redacted-structured-summary",
    "cleanup_policy": "always-residue-checked",
    "concurrency_policy": "caller-owned",
    "max_reusable_workflow_depth": 1,
    "forbidden_caller_fields": ["runner", "runs_on", "runner_labels", "container_engine", "docker_command", "buildah_command", "registry_host", "registry_command", "secret_name", "kubeconfig_path", "cluster", "namespace", "arbitrary_command", "shell", "callback_url", "product_id"]
  },
  "trust_classes": {
    "source-admission": {"reference_policy": "bootstrap-main-or-immutable", "allowed_events": ["pull_request", "push", "workflow_dispatch", "workflow_call", "tag-push", "workflow_run", "issue_comment", "pull_request_target"], "executes_caller_source": false, "privileged": false},
    "read-only-validation": {"reference_policy": "bootstrap-main-or-immutable", "allowed_events": ["pull_request", "push", "workflow_dispatch", "workflow_call"], "executes_caller_source": true, "privileged": false},
    "physical-device-validation": {"reference_policy": "bootstrap-main-or-immutable", "allowed_events": ["workflow_dispatch", "workflow_call"], "executes_caller_source": true, "privileged": true},
    "trusted-publication": {"reference_policy": "bootstrap-main-or-immutable", "allowed_events": ["tag-push", "workflow_call", "workflow_dispatch-verify-only", "workflow_dispatch-existing-tag"], "executes_caller_source": true, "privileged": true}
  },
  "input_catalog": {
    "source_mode": {"type": "string", "enum": ["auto", "pr-head", "pr-merge", "push", "manual", "workflow-call", "tag", "trusted-maintenance"]},
    "requested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "admitted_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "nullable": true},
    "expected_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,255}$", "nullable": true},
    "release_contract": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "execution_backend": {"type": "string", "enum": ["organization", "github-hosted"], "default": "organization"},
    "ecosystem": {"type": "string", "enum": ["python", "npm", "jvm"]},
    "package_name": {"type": "string", "pattern": "^[A-Za-z0-9@][A-Za-z0-9@._/-]{0,127}$"},
    "package_group": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,254}[A-Za-z0-9])?$", "nullable": true},
