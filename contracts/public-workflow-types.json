    "validation_plan_json": {"type": "json-object", "max_bytes": 16384},
    "dependency_prebuild_plan_json": {"type": "json-object", "max_bytes": 16384},
    "consumer_contract": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "change_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "policy_script_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "version_file": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
