    "platform": {"type": "string", "enum": ["linux", "android", "ios", "tvos", "macos"], "nullable": true},
    "scheme": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "nullable": true},
    "destination_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "device_family": {"type": "string", "enum": ["android", "ios", "tvos"], "nullable": true},
    "device_capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "host_capacity": {"type": "string", "enum": ["mobile", "apple"]},
    "prepare_script_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "test_script_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "evidence_script_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "cleanup_script_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "arguments_json": {"type": "json-array", "max_items": 16},
    "environment_json": {"type": "json-object", "max_bytes": 16384},
    "max_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 240, "default": 60},
    "release_mode": {"type": "string", "enum": ["tag-push", "existing-tag"], "default": "tag-push"},
    "release_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$", "nullable": true},
    "release_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "evidence_exception_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "image_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "chart_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "chart_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "dockerfile_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "build_context": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "default": "."},
    "publish_latest_image": {"type": "boolean", "default": false},
    "static_output_directory": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "history_depth": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1}
  },
  "secret_catalog": {
    "private_dependency_token": {"required_scope": "contents:read", "exposed_to_product_source": false},
    "repository_app_id": {"required_scope": "github-app-identity", "exposed_to_product_source": false},
    "repository_app_private_key": {"required_scope": "github-app-signing", "exposed_to_product_source": false},
    "maven_package_read_token": {"required_scope": "package-read", "exposed_to_product_source": true},
    "service_username": {"required_scope": "test-environment", "exposed_to_product_source": true},
    "service_password": {"required_scope": "test-environment", "exposed_to_product_source": true},
    "registry_username": {"required_scope": "registry-write", "exposed_to_product_source": false},
    "registry_token": {"required_scope": "registry-write", "exposed_to_product_source": false},
    "device_authorization_receipt": {"required_scope": "physical-device-authorization", "exposed_to_product_source": false}
  },
