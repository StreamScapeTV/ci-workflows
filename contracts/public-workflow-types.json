{
  "schema_version": 1,
  "organization": "StreamScapeTV",
  "reference_policy": {
    "full_sha_pattern": "^[0-9a-f]{40}$",
    "semver_tag_pattern": "^v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
    "immutable_references": ["full-sha", "immutable-semver-tag"],
    "bootstrap_mutable_reference": "main",
    "bootstrap_mutable_allowed_trust_classes": [
      "source-admission",
      "read-only-validation",
      "physical-device-validation",
      "trusted-publication",
      "flux-authorized",
      "trusted-maintenance"
    ],
    "privileged_mutable_references_forbidden": false,
    "consumer_updates": "reviewable-pull-request",
    "rollback_reference_required": true,
    "delete_referenced_release_forbidden": true
  },
  "compatibility_policy": {
    "compatible": [
      "add workflow",
      "add optional input without behavior change",
      "add output",
      "widen documented supported consumer without privilege change",
      "documentation clarification"
    ],
    "conditional": [
      "tighten input validation within documented bounds",
      "change internal implementation or named function without public behavior change",
      "change timeout or matrix within published maximum",
      "deprecate with replacement and supported window"
    ],
    "breaking": [
      "remove or rename workflow",
      "remove or rename input/output/secret/check",
      "add required input or secret",
      "change default behavior",
      "expand caller permissions",
      "change trust class or reference policy",
      "change semantic runner class incompatibly",
      "remove product or consumer support",
      "increase reusable-workflow depth"
    ],
    "acknowledgement_required_fields": [
      "id",
      "api_name",
      "kind",
      "reason",
      "migration_issue",
      "effective_version"
    ]
  },
  "defaults": {
    "artifact_policy": "zero-default-named-exception-only",
    "evidence_policy": "redacted-structured-summary",
    "cleanup_policy": "always-residue-checked",
    "concurrency_policy": "caller-owned",
    "max_reusable_workflow_depth": 1,
    "forbidden_caller_fields": [
      "runner",
      "runs_on",
      "runner_labels",
      "container_engine",
      "docker_command",
      "buildah_command",
      "registry_host",
      "registry_command",
      "secret_name",
      "kubeconfig_path",
      "cluster",
      "namespace",
      "arbitrary_command",
      "shell",
      "callback_url"
    ]
  },
  "trust_classes": {
    "source-admission": {
      "reference_policy": "bootstrap-main-or-immutable",
      "allowed_events": ["pull_request", "push", "workflow_dispatch", "workflow_call", "tag-push", "workflow_run", "issue_comment", "pull_request_target"],
      "executes_caller_source": false,
      "privileged": false
    },
    "read-only-validation": {
      "reference_policy": "bootstrap-main-or-immutable",
      "allowed_events": ["pull_request", "push", "workflow_dispatch", "workflow_call"],
      "executes_caller_source": true,
      "privileged": false
    },
    "physical-device-validation": {
      "reference_policy": "bootstrap-main-or-immutable",
      "allowed_events": ["workflow_dispatch", "workflow_call"],
      "executes_caller_source": true,
      "privileged": true
    },
    "trusted-publication": {
      "reference_policy": "bootstrap-main-or-immutable",
      "allowed_events": ["tag-push", "workflow_call", "workflow_dispatch-verify-only", "workflow_dispatch-existing-tag"],
      "executes_caller_source": true,
      "privileged": true
    },
    "flux-authorized": {
      "reference_policy": "bootstrap-main-or-immutable",
      "allowed_events": ["workflow_dispatch", "repository_dispatch", "workflow_call"],
      "executes_caller_source": false,
      "privileged": true
    },
    "trusted-maintenance": {
      "reference_policy": "bootstrap-main-or-immutable",
      "allowed_events": ["schedule", "workflow_dispatch", "pull_request-closed", "workflow_call"],
      "executes_caller_source": false,
      "privileged": true
    }
  },
  "input_catalog": {
    "source_mode": {"type": "string", "enum": ["auto", "pr-head", "pr-merge", "push", "manual", "workflow-call", "tag", "trusted-maintenance"]},
    "requested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "admitted_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "expected_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,255}$", "nullable": true},
    "release_contract": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "pr_number": {"type": "integer", "minimum": 1, "nullable": true},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "validation_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "consumer_contract": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "change_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "policy_script_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "task_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "version_file": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "node_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$", "nullable": true},
    "working_directory": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "default": "."},
    "gradle_wrapper_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "default": "gradlew"},
    "install_profile": {"type": "string", "enum": ["npm-ci", "none"]},
    "command_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "script_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "consumer_script_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "targeted_test_selector": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*(?:\.[A-Za-z_][A-Za-z0-9_$]*){2,31}$", "nullable": true},
    "output_verifier_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "public_environment": {"type": "json-object", "nullable": true},
    "artifact_exception_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "private_dependency_contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "private_dependency_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "nullable": true},
    "private_dependency_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "private_dependency_subdirectory": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "test_filter": {"type": "string", "pattern": "^[A-Za-z0-9_.*#\[\]-]{1,200}$", "nullable": true},
    "platform": {"type": "string", "enum": ["linux", "android", "ios", "tvos", "macos"], "nullable": true},
    "scheme": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "nullable": true},
    "destination_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "device_family": {"type": "string", "enum": ["android", "android-phone", "android-tv", "ios", "tvos"], "nullable": true},
    "device_request_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "device_capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "device_alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "max_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 240, "default": 60},
    "product_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "release_mode": {"type": "string", "enum": ["tag-push", "existing-tag"], "default": "tag-push"},
    "release_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$", "nullable": true},
    "release_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "image_recovery_authority": {"type": "string", "nullable": true},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "nullable": true},
    "immutable_references_json": {"type": "json-object", "nullable": true},
    "release_tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "nullable": true},
    "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "policy_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "allowlist_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "evidence_exception_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "dry_run": {"type": "boolean", "default": true},
    "repository_scope": {"type": "json-array", "max_items": 100, "nullable": true},
    "run_id": {"type": "integer", "minimum": 1, "nullable": true},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "image_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "chart_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "chart_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "dockerfile_path": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "build_context": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "default": "."},
    "static_output_directory": {"type": "path", "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$", "nullable": true},
    "postgres_enabled": {"type": "boolean", "default": false},
    "history_depth": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1},
    "values_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$", "nullable": true},
    "platform_set": {"type": "json-array", "max_items": 8, "nullable": true}
  },
  "secret_catalog": {
    "private_dependency_token": {"required_scope": "contents:read", "exposed_to_product_source": false},
    "registry_username": {"required_scope": "registry-write", "exposed_to_product_source": false},
    "registry_token": {"required_scope": "registry-write", "exposed_to_product_source": false},
    "device_authorization_receipt": {"required_scope": "physical-device-authorization", "exposed_to_product_source": false},
    "live_test_credentials": {"required_scope": "test-environment", "exposed_to_product_source": true},
    "flux_handoff_token": {"required_scope": "flux-dispatch", "exposed_to_product_source": false},
    "flux_kubeconfig": {"required_scope": "kubernetes-target", "exposed_to_product_source": false},
    "flux_sops_age_key": {"required_scope": "sops-decrypt", "exposed_to_product_source": false},
    "organization_maintenance_token": {"required_scope": "organization-maintenance", "exposed_to_product_source": false},
    "organization_read_token": {"required_scope": "organization-read", "exposed_to_product_source": false},
    "organization_update_token": {"required_scope": "organization-update", "exposed_to_product_source": false}
  },
  "output_catalog": {
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "trust_mode": {"type": "string"},
    "tag_name": {"type": "string", "nullable": true},
    "version": {"type": "string", "nullable": true},
    "request_id": {"type": "string"},
    "result": {"type": "string", "enum": ["success", "failure", "skipped"]},
    "test_summary": {"type": "json-object", "nullable": true},
    "render_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "nullable": true},
    "artifact_exception_used": {"type": "boolean"},
    "node_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$"},
    "npm_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)$"},
    "install_result": {"type": "string", "enum": ["success", "failure", "skipped"]},
    "build_result": {"type": "string", "enum": ["success", "failure", "skipped"]},
    "output_verified": {"type": "boolean"},
    "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "nullable": true},
    "clean_tree": {"type": "boolean"},
    "cleanup_result": {"type": "string", "enum": ["success", "failure"]},
    "device_evidence_id": {"type": "string", "nullable": true},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "nullable": true},
    "platform_digests_json": {"type": "json-object", "nullable": true},
    "resolved_inputs_json": {"type": "json-object", "nullable": true},
    "chart_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "nullable": true},
    "immutable_references_json": {"type": "json-object", "nullable": true},
    "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "nullable": true},
    "handoff_state": {"type": "string", "nullable": true},
    "reconciliation_state": {"type": "string", "nullable": true},
    "mutation_count": {"type": "integer", "minimum": 0},
    "report_issue_url": {"type": "string", "nullable": true},
    "retry_run_id": {"type": "integer", "nullable": true},
    "image_reference": {"type": "string", "nullable": true},
    "chart_reference": {"type": "string", "nullable": true},
    "chart_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "nullable": true},
    "caller_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "caller_default_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,255}$"},
    "caller_integration_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,255}$"},
    "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "requested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "resolved_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pr_number": {"type": "integer", "minimum": 1, "nullable": true},
    "pr_head_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "nullable": true},
    "pr_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "pr_base_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]{1,255}$", "nullable": true},
    "pr_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "pr_merge_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "tag_object_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "tag_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "nullable": true},
    "requires_freshness": {"type": "boolean"},
    "history_depth": {"type": "integer", "minimum": 1, "maximum": 1000},
    "evidence_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{7,63}$"}
  },
  "breaking_change_acknowledgements": []
}
