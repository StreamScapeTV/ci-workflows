  "breaking_change_acknowledgements": [
    {"id": "issue-332-android", "api_name": "validation.android", "kind": "technology-input-decoupling", "reason": "Replace central Android product/task profiles with one caller-owned bounded validation plan.", "migration_issue": "#332", "effective_version": "2.0.0"},
    {"id": "issue-443-android-package-read", "api_name": "validation.android", "kind": "fixed-credential-projection", "reason": "Allow one fixed package-read credential only in bounded product execution for registry-resolved Android dependencies.", "migration_issue": "#443", "effective_version": "2.1.0"},
    {"id": "issue-443-android-live-package-read", "api_name": "validation.android-live-service", "kind": "fixed-credential-projection", "reason": "Allow one fixed package-read credential only in bounded product execution for registry-resolved Android dependencies.", "migration_issue": "#443", "effective_version": "1.1.0"},
    {"id": "issue-443-android-release-package-read", "api_name": "validation.android-release", "kind": "fixed-credential-projection", "reason": "Allow one fixed package-read credential only in bounded product execution for registry-resolved Android dependencies.", "migration_issue": "#443", "effective_version": "1.1.0"},
    {"id": "issue-341-device", "api_name": "validation.device", "kind": "technology-input-decoupling", "reason": "Replace product-coupled device aliases and profiles with semantic host capacity and caller-owned bounded command plans.", "migration_issue": "#341", "effective_version": "2.0.0"},
    {"id": "issue-336-apple", "api_name": "validation.apple", "kind": "technology-input-decoupling", "reason": "Protected-full Apple validation now requires a bounded fail-closed validation_plan_json and executes sequential stages in one semantic macOS workspace.", "migration_issue": "#336", "effective_version": "2.0.0"},
    {"id": "issue-495-apple-central-repository-access", "api_name": "validation.apple", "kind": "fixed-credential-projection", "reason": "Allow the canonical Apple reusable workflow to mint fixed contents-read repository credentials for an explicitly selected external source or dependency repository without changing caller permissions or product execution authority.", "migration_issue": "#495", "effective_version": "2.1.0"},
    {"id": "issue-473-python", "api_name": "validation.python", "kind": "technology-input-decoupling", "reason": "Replace Central repository-keyed Python command profiles with one caller-owned checked-in executable script plus bounded generic runtime and dependency inputs.", "migration_issue": "#473", "effective_version": "2.0.0"},
    {"id": "issue-474-tag-image-recovery", "api_name": "release.tag-image-chart-bootstrap", "kind": "remove-product-specific-recovery-input", "reason": "Remove the unused IPTV Backend-specific one-off recovery authority and return the deprecated bootstrap API to product-neutral exact-tag publication.", "migration_issue": "#474", "effective_version": "2.0.0"}
  ]
