{
  "schema_version": 1,
  "contract_version": "1.0.0",
  "workflow_api": "flux.assets",
  "source_repository": "StreamScapeTV/flux",
  "artifact_policy": "zero",
  "cluster_mutation_authorized": false,
  "kubernetes_credentials": false,
  "latest_forbidden": true,
  "dependency_interfaces": {
    "oci.build": {
      "product_id": "flux-runner-images",
      "required_outputs": [
        "result",
        "image_digest",
        "platform_digests_json",
        "artifact_exception_used"
      ]
    },
    "oci.publish": {
      "product_id": "flux-runner-images",
      "required_outputs": [
        "result",
        "image_digest",
        "platform_digests_json",
        "immutable_references_json"
      ]
    },
    "helm.validate": {
      "product_id": "flux-github-actions-runner-chart",
      "required_outputs": [
        "result",
        "chart_digest",
        "artifact_exception_used"
      ]
    },
    "helm.publish": {
      "product_id": "flux-github-actions-runner-chart",
      "required_outputs": [
        "result",
        "chart_digest",
        "immutable_references_json"
      ]
    }
  },
  "products": {
    "flux-runner-images": {
      "kind": "runner-image-family",
      "policy_roots": [
        "images/github-actions-runner-buildah",
        "images/github-actions-runner-mobile",
        "scripts/github-actions-runner"
      ],
      "runner_profiles": {
        "plan": {
          "labels": ["linux", "amd64", "general"],
          "workspace_profile": "minimal"
        },
        "release": {
          "labels": ["linux", "amd64", "buildah", "high"],
          "workspace_profile": "large"
        },
        "verify-only": {
          "labels": ["linux", "amd64", "buildah", "small"],
          "workspace_profile": "standard"
        }
      },
      "operations": {
        "plan": [],
        "release": ["oci.build", "oci.publish"],
        "verify-only": ["oci.publish"]
      },
      "bootstrap": {
        "known_good_required": true,
        "builder_profile": "buildah-high",
        "candidate_must_not_build_itself": true,
        "builder_reference_policy": "flux-policy:runner-images/current-known-good"
      },
      "handoff": {
        "canary_id": "flux-runner-images-canary",
        "previous_known_good_policy": "flux-policy:runner-images/current-known-good",
        "rollback_id": "flux-runner-images-rollback"
      },
      "members": [
        {
          "id": "github-actions-runner-buildah",
          "source_root": "images/github-actions-runner-buildah",
          "dockerfile_path": "images/github-actions-runner-buildah/Dockerfile",
          "platform": {"os": "linux", "architecture": "amd64"},
          "required_tools": {
            "actions-runner": "2.336.0",
            "buildah": "1.33.7",
            "skopeo": "1.13.3",
            "podman": "4.9.3"
          },
          "forbidden_tools": ["docker", "dockerd", "kubectl"],
          "forbidden_sockets": ["/var/run/docker.sock", "/run/docker.sock"],
          "required_labels": {
            "io.streamscapetv.runner.class": "buildah-linux-x64",
            "io.streamscapetv.runner.platform": "linux/amd64",
            "io.streamscapetv.container.engine": "daemonless",
            "io.streamscapetv.container.toolchain": "buildah-skopeo-podman"
          },
          "subordinate_id": "runner:100000:65536",
          "storage_driver": "vfs",
          "digest_pinned_bases_required": true
        },
        {
          "id": "github-actions-runner-mobile",
          "source_root": "images/github-actions-runner-mobile",
          "dockerfile_path": "images/github-actions-runner-mobile/Dockerfile",
          "platform": {"os": "linux", "architecture": "amd64"},
          "required_tools": {
            "actions-runner": "2.336.0",
            "java": "25",
            "flutter": "3.44.8",
            "dart": "3.12.2",
            "node": "24.18.0",
            "android-platform": "37",
            "android-compat-platform": "36",
            "android-build-tools": "37.0.0",
            "android-compat-build-tools": "36.0.0",
            "android-ndk": "28.2.13676358"
          },
          "forbidden_tools": ["docker", "dockerd", "kubectl"],
          "forbidden_sockets": ["/var/run/docker.sock", "/run/docker.sock"],
          "required_labels": {
            "io.streamscapetv.runner.version": "2.336.0",
            "io.streamscapetv.java.version": "25",
            "io.streamscapetv.flutter.version": "3.44.8",
            "io.streamscapetv.dart.version": "3.12.2",
            "io.streamscapetv.node.version": "24.18.0",
            "io.streamscapetv.android.platform": "37",
            "io.streamscapetv.android.ndk": "28.2.13676358"
          },
          "digest_pinned_bases_required": true
        }
      ]
    },
    "flux-runner-chart-assets": {
      "kind": "runner-chart-bundle",
      "chart_root": "apps/github-actions-runner",
      "inventory_chart_version": "1.3.0",
      "inventory_app_version": "0.14.2",
      "policy_roots": [
        "apps/github-actions-runner",
        "scripts/github-actions-runner",
        "clusters/devops/flux-system-common/helm-repository"
      ],
      "runner_profiles": {
        "plan": {
          "labels": ["linux", "amd64", "general"],
          "workspace_profile": "minimal"
        },
        "release": {
          "labels": ["linux", "amd64", "buildah", "small"],
          "workspace_profile": "standard"
        },
        "verify-only": {
          "labels": ["linux", "amd64", "buildah", "small"],
          "workspace_profile": "standard"
        }
      },
      "operations": {
        "plan": [],
        "release": ["helm.validate", "helm.publish"],
        "verify-only": ["helm.publish"]
      },
      "bootstrap": {
        "known_good_required": true,
        "builder_profile": "buildah-small",
        "candidate_must_not_build_itself": true,
        "builder_reference_policy": "flux-policy:runner-assets/current-known-good"
      },
      "handoff": {
        "canary_id": "flux-runner-chart-assets-canary",
        "previous_known_good_policy": "flux-policy:runner-chart-assets/current-known-good",
        "rollback_id": "flux-runner-chart-assets-rollback"
      },
      "upstream_assets": [
        {
          "id": "gha-runner-scale-set-controller",
          "upstream_repository": "oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set-controller",
          "version": "0.14.2",
          "license": "Apache-2.0",
          "digest_required": true,
          "flux_source_file": "clusters/devops/flux-system-common/helm-repository/gha-runner-scale-set-controller.oci.yaml"
        },
        {
          "id": "gha-runner-scale-set",
          "upstream_repository": "oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set",
          "version": "0.14.2",
          "license": "Apache-2.0",
          "digest_required": true,
          "flux_source_file": "clusters/devops/flux-system-common/helm-repository/gha-runner-scale-set.oci.yaml"
        }
      ]
    }
  }
}
