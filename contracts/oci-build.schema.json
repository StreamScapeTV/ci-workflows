{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streamscape.tv/contracts/oci-build.schema.json",
  "title": "StreamScapeTV OCI build request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admitted_sha",
    "product_id"
  ],
  "properties": {
    "admitted_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "release_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "platform_set": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "linux-amd64",
        "linux-multi-arch"
      ]
    },
    "artifact_exception_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 0
    }
  }
}
