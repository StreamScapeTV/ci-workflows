{
  "schema_version": 1,
  "provider": "cloudflare-r2",
  "api": "s3-compatible",
  "region": "auto",
  "storage_class": "STANDARD",
  "object_prefix": "ci-diagnostics",
  "object_extension": ".log.gz",
  "object_format": "ci-diagnostics/<request_id>/<128-bit-capability>/<run_id>-<attempt>.log.gz",
  "object_capability": {
    "bits": 128,
    "encoding": "lowercase-hex",
    "derivation": "domain-separated-hmac-sha256",
    "key_authority": "r2-write-secret-only",
    "inputs": [
      "request_id",
      "run_id",
      "attempt",
      "compressed_sha256"
    ],
    "read_service_can_mint": false
  },
  "max_raw_bytes": 52428800,
  "max_compressed_bytes": 20971520,
  "max_objects_per_request": 1,
  "readback_required": true,
  "compression": {
    "format": "gzip",
    "level": 9,
    "mtime": 0
  },
  "environment": {
    "account_id": "R2_ACCOUNT_ID",
    "bucket": "R2_BUCKET",
    "access_key_id": "R2_ACCESS_KEY_ID",
    "secret_access_key": "R2_SECRET_ACCESS_KEY"
  },
  "runtime_operations": [
    "put-object",
    "get-object"
  ],
  "forbidden_runtime_operations": [
    "list-bucket",
    "create-bucket",
    "delete-bucket",
    "public-url",
    "presigned-url",
    "lifecycle-mutation"
  ],
  "required_remote_lifecycle_max_days": 7
}
