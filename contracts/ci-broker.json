{
  "schema_version": 4,
  "central_repository": "StreamScapeTV/ci-workflows",
  "central_workflow": ".github/workflows/central-ci-dispatch.yml",
  "central_ref": "main",
  "supported_capabilities": [
    "apple-host-test",
    "android-hosted",
    "python-hosted"
  ],
  "relay": {
    "role": "authenticated-fire-and-forget-transport",
    "routes": ["/healthz", "/hooks/agent-state"],
    "agent_state_event": "ci_runs INSERT",
    "dispatch_inputs": ["active_key", "ci_run_id"],
    "active_identity_fields": ["repository", "ref", "is_tag"],
    "active_key": "sha256-canonical-active-identity",
    "requested_sha_forbidden": true,
    "private_identity_in_public_dispatch": false,
    "replayed_accepted_request_recoverable": true,
    "run_discovery": false,
    "supported_semantic_intents": [
      ["validation.apple", "host"],
      ["validation.android", "host"],
      ["validation.python", "host"]
    ]
  },
  "agent_state": {
    "schema": "agent_api",
    "transport": "supabase-secret-api-key",
    "rpc_only": true,
    "retention_hours": 24,
    "source_repository_field": "repository",
    "execution_repository_field": "external_repository",
    "relay_functions": ["claim_ci_run", "transition_ci_run"],
    "workflow_functions": ["claim_ci_run", "register_ci_run", "transition_ci_run"],
    "discovery_functions": ["get_ci_run", "list_ci_runs"],
    "raw_logs_forbidden": true,
    "private_log_receipt_fields": ["diagnostic_key", "diagnostic_status"]
  },
  "central_execution": {
    "request_lookup": "claim-ci-run-by-opaque-uuid",
    "source_mode": "requested-ref-internal",
    "request_identity": "repository-ref-is_tag-workflow-profile",
    "observed_sha": "evidence-only",
    "private_config_path": ".github/central-ci.json",
    "profile_function": "ci_workflows.central_profile.resolve_profile",
    "executor_planning_output": "linux-or-macos-only",
    "implementations": {
      "validation.apple": "ci_workflows.ciw_apple.execute_apple_validate",
      "validation.android": "ci_workflows.ciw_android.execute_android_validate",
      "validation.python": "ci_workflows.ciw_python.execute_python_validate"
    },
    "public_dispatch_private_fields": false,
    "source_and_dependency_credentials": "fixed-source-app-secrets",
    "hosted_runners": {
      "linux": "ubuntu-latest",
      "macos": "macos-latest"
    },
    "caller_selected_runner": false,
    "caller_selected_workflow_path": false,
    "caller_selected_secret_name": false
  },
  "private_logs": {
    "store": "cloudflare-r2",
    "format": "gzip-private-runner-log",
    "object_prefix": "ci-diagnostics",
    "github_public_log": "generic-orchestration-and-pass-fail-only",
    "private_command_stdout_stderr": "runner-local-only",
    "readback_required": true,
    "digest": "sha256-of-compressed-object",
    "agent_state_payload": "r2-receipt-status-and-stable-error-only",
    "terminal_order": "upload-readback-verify-r2-before-agent-state-terminal"
  },
  "fixed_environment": {
    "relay": [
      "GITHUB_DISPATCH_APP_ID",
      "GITHUB_DISPATCH_APP_PRIVATE_KEY",
      "AGENT_STATE_SUPABASE_URL",
      "AGENT_STATE_SUPABASE_SECRET_KEY",
      "AGENT_STATE_WEBHOOK_SECRET"
    ],
    "central_workflow_secrets": [
      "AGENT_STATE_SUPABASE_URL",
      "AGENT_STATE_SUPABASE_SECRET_KEY",
      "SOURCE_APP_ID",
      "SOURCE_APP_PRIVATE_KEY",
      "R2_ACCOUNT_ID",
      "R2_BUCKET",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "MAVEN_PACKAGE_READ_TOKEN"
    ]
  },
  "forbidden": [
    "broker-source-resolution",
    "broker-source-checkout",
    "broker-product-config-read",
    "broker-dependency-admission",
    "broker-build-or-test",
    "broker-log-storage",
    "broker-github-run-discovery",
    "broker-actions-callback",
    "broker-diagnostics-http-reader",
    "requested-sha-branch-authority",
    "private-repository-in-public-dispatch-input",
    "private-ref-in-public-dispatch-input",
    "private-command-output-in-public-github-log",
    "cloudflare-d1-diagnostic-store",
    "caller-selected-secret-name",
    "caller-selected-runner",
    "caller-selected-workflow-path",
    "raw-agent-state-table-query",
    "raw-log-storage-in-agent-state",
    "github-actions-artifact-private-log",
    "polling-dispatch-loop"
  ]
}
