{
  "schema_version": 1,
  "forbid_secrets_inherit": true,
  "require_exact_source": true,
  "require_persist_credentials_false": true,
  "forbid_privileged_untrusted_source": true,
  "release_reference_policy": {
    "bootstrap_channel": "main",
    "supported_immutable_references": ["full-sha", "git-tag"],
    "github_release_required": false,
    "attached_artifacts_required": false
  },
  "routine_artifact_policy": "zero"
}
