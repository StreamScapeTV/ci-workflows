FROM docker.io/library/python@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

WORKDIR /opt/ci-broker
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --chown=65532:65532 app.py /opt/ci-broker/app.py

RUN set -eux; \
    python3 --version; \
    command -v openssl >/dev/null; \
    python3 /opt/ci-broker/app.py self-check

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["python3", "/opt/ci-broker/app.py", "server"]
